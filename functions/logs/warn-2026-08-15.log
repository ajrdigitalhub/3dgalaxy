ge.app/product-import/1784443875291-907681875.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877379-27569333.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877476-33614436.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"440bc2f4-247a-4a4d-866e-0489268ca62f","sku":"anycubic-water-wash-resin-2-0-1kg-clear","name":"clear","price":"1999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-22T07:54:58.284Z","deletedAt":null,"isDefault":false,"productId":"17942f58-ae23-41f3-a185-4749d4cb1309","salePrice":null,"updatedAt":"2026-07-22T07:54:58.284Z","variantSlug":null,"optionValues":{"Color":"clear"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp"},{"id":"727dd83e-4af6-4354-8096-d366707a0994","sku":"anycubic-water-wash-resin-2-0-1kg-white","name":"white","price":"1999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-22T07:54:58.591Z","deletedAt":null,"isDefault":false,"productId":"17942f58-ae23-41f3-a185-4749d4cb1309","salePrice":null,"updatedAt":"2026-07-22T07:54:58.591Z","variantSlug":null,"optionValues":{"Color":"white"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"}],"salePrice":1999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","isFeatured":true,"category_id":"6bc58c59-9787-4fcd-bac2-8cc779a56e60","dealerPrice":1999,"description":"<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Version 2.0 formula — stronger, faster, more stable</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Water washable — no alcohol needed</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>HD gray color enhances detail visibility</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Low shrinkage and low odor</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Compatible with 365–405 nm UV printers<br></p>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Super Easy to Clean】Anycubic Water Washable Resin 2.0 contains hydrophilic groups with good water solubility, which is can be directly cleaned with water instead of alcohol and greatly save the cost of alcohol use. Besides, it can also be cleaned by Anycubic Wash and Cure Machine or ultrasonic cleaning.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Anti-Yellowing &amp; Stay Vibrant】The upgraded formula for Anycubic Water Washable Resin 2.0 ensures models retain vibrant colors even after prolonged exposure, a breakthrough particularly effective for White and Transparent resins.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Lower Shrinkage Rate &amp; High Precision Models】With a precision of up to 0.15mm, Anycubic Water Washable Resin 2.0 perfectly meets the extreme demands for detail in miniature models.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High-Resilience &amp; Less Prone to Cracking】 An impressive elongation rate of 16.62% ensures cured models are highly flexible, long lasting and resistant to cracking.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Less Odor for Indoor Use】 The optimized formula making Anycubic 3D Printer Resin Water Washable significantly reduces resin odor during storage and printing, ensuring a more comfortable printing experience.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Low Viscosity &amp; High Print Success Rates】The enhanced platform adhesion provides stable, high quality prints with high print success rates.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Compatibility】 Anycubic Water Washable Resin 2.0 is compatible with a wide range of LCD and DLP 3D printers operating within the 365-405nm wavelength, our resin offers seamless integration with most printers on the market.</li>\n</ul>\n</div>\n</div>\n</div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875043-588113816.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875291-907681875.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877379-27569333.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877476-33614436.webp"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","shortDescription":"<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Version 2.0 formula — stronger, faster, more stable</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Water washable — no alcohol needed</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>HD gray color enhances detail visibility</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Low shrinkage and low odor</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Compatible with 365–405 nm UV printers<br></p>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Super Easy to Clean】Anycubic Water Washable Resin 2.0 contains hydrophilic groups with good water solubility, which is can be directly cleaned with water instead of alcohol and greatly save the cost of alcohol use. Besides, it can also be cleaned by Anycubic Wash and Cure Machine or ultrasonic cleaning.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Anti-Yellowing &amp; Stay Vibrant】The upgraded formula for Anycubic Water Washable Resin 2.0 ensures models retain vibrant colors even after prolonged exposure, a breakthrough particularly effective for White and Transparent resins.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Lower Shrinkage Rate &amp; High Precision Models】With a precision of up to 0.15mm, Anycubic Water Washable Resin 2.0 perfectly meets the extreme demands for detail in miniature models.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High-Resilience &amp; Less Prone to Cracking】 An impressive elongation rate of 16.62% ensures cured models are highly flexible, long lasting and resistant to cracking.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Less Odor for Indoor Use】 The optimized formula making Anycubic 3D Printer Resin Water Washable significantly reduces resin odor during storage and printing, ensuring a more comfortable printing experience.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Low Viscosity &amp; High Print Success Rates】The enhanced platform adhesion provides stable, high quality prints with high print success rates.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Compatibility】 Anycubic Water Washable Resin 2.0 is compatible with a wide range of LCD and DLP 3D printers operating within the 365-405nm wavelength, our resin offers seamless integration with most printers on the market.</li>\n</ul>\n</div>\n</div>\n</div>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"]}],"bundleDeals":[{"id":"a12db046-1afc-461d-a3e2-01def4c3f039","mrp":46999,"sku":"creality-sparkx-i7-combo-3d-printer","name":"Creality SPARKX i7 Combo 3D Printer","slug":"creality-sparkx-i7-combo-3d-printer","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443889867-552990252.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443889669-478859701.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443889633-190488225.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"273917f1-5b35-4b3b-8c71-1fdf41e77202","sku":"creality-sparkx-i7-combo-3d-printer-Default Title","name":"Default Title","price":"46999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"20000","isActive":true,"createdAt":"2026-07-19T06:55:25.251Z","deletedAt":null,"isDefault":false,"productId":"a12db046-1afc-461d-a3e2-01def4c3f039","salePrice":null,"updatedAt":"2026-07-19T06:55:25.251Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg"}],"salePrice":46999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443890530-419247617.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":46999,"description":"<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>AI Photo-to-3D: One-tap photo to print, no modeling required.</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>50% Less-Waste Multicolor: Richer colors, less filament waste.</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>45 dB Night Mode: Runs as softly as turning a page. Fits seamlessly in any home, office, or studio—even overnight.</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Custom RGB Lighting: Print status visible at a glance.</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Beginner-Friendly: Easy setup, from box to first print in under 5 minutes.</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Quick-Swap Parts: Tool-free part replacement for easy maintenance and minimal downtime.<br><br></p>\n<p>Creality SPARKX i7 3D Printer – Smart AI Desktop Multicolor 3D Printer</p>\n<p>The Creality SPARKX i7 3D Printer is a next-generation smart AI desktop 3D printer designed for effortless, high-precision 3D printing. Built with advanced features such as AI-powered print monitoring, automatic bed leveling, and quick-swap maintenance components, the SPARKX i7 ensures reliable performance and professional-quality prints.</p>\n<p>With a large 260 × 260 × 255 mm build volume, this Creality 3D printer is capable of printing everything from detailed miniatures, figurines, prototypes, and gaming accessories to large functional models. The printer also supports multicolor 3D printing with up to 4 colors, helping creators produce vibrant and complex models while reducing filament waste.</p>\n<p>The built-in AI camera monitoring system detects common printing issues such as spaghetti failure, filament tangling, air printing, and build plate errors in real time, improving overall print success rates. The programmable RGB status lighting system visually indicates the printing status, keeping users informed throughout the printing process.</p>\n<p>With ultra-quiet 30 dB night mode operation, automatic calibration, and a fast 5-minute setup, the SPARKX i7 provides a seamless and user-friendly 3D printing experience. Whether you are a beginner, hobbyist, designer, educator, or professional maker, this smart Creality 3D printer makes creating high-quality models easier than ever.<br><br></p>\n<div class=\"elementor-element elementor-element-4897b4db e-flex e-con-boxed e-con e-parent e-lazyloaded\" data-id=\"4897b4db\" data-element_type=\"container\" data-e-type=\"container\">\n<div class=\"e-con-inner\">\n<div class=\"elementor-element elementor-element-3272e9a2 elementor-widget elementor-widget-text-editor\" data-id=\"3272e9a2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n<div class=\"flex flex-col text-sm pb-25\">\n<article class=\"text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]\" dir=\"auto\" data-turn-id=\"request-WEB:09bb7efe-8f99-4536-b19f-e706352d7a34-49\" data-testid=\"conversation-turn-6\" data-scroll-anchor=\"true\" data-turn=\"assistant\" style=\"margin: 0px; padding: 0px; box-sizing: border-box; border-color: var(--loobek-border);\" tabindex=\"-1\">\n<div class=\"text-base my-auto mx-auto pb-10 [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)\">\n<div class=\"[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn\" tabindex=\"-1\">\n<div class=\"flex max-w-full flex-col gap-4 grow\">\n<div class=\"min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1\" dir=\"auto\" data-message-author-role=\"a