estorage.app/product-import/1784444017381-274551946.jpg"},{"id":"96a66452-a6a7-4bf2-8c09-33f8dd7f1a5c","sku":"elegoo-standard-photopolymer-high-precision-3d-printer-resin-CLEAR BLUE","name":"CLEAR BLUE","price":"1699","stock":1,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444019638-283830424.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444017837-6537328.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1000","isActive":true,"createdAt":"2026-07-19T06:59:33.662Z","deletedAt":null,"isDefault":false,"productId":"337701d3-cd8e-4fb4-a5eb-5b68664f8064","salePrice":null,"updatedAt":"2026-07-19T06:59:33.662Z","variantSlug":null,"optionValues":{"Color":"CLEAR BLUE"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444019638-283830424.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444019638-283830424.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444017837-6537328.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444019638-283830424.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444017837-6537328.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444017837-6537328.jpg"}],"salePrice":1699,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013732-711830361.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":1699,"description":"<h4><strong>ELEGOO Standard Photopolymer High Precision 3D Printer Resin</strong></h4>\n<p>Introducing the<span> </span><strong>ELEGOO Standard Photopolymer 3D Printer Resin</strong><span> </span>– your key to unlocking the world of flawless<span> </span><strong>3D printing</strong>. Crafted with precision and innovation, our resin is engineered to meet the highest standards of quality and performance. Elevate your<strong><span> </span>3D printing experience with ELEGOO.</strong></p>\n<p>Are you tired of subpar prints with uneven finishes?<strong><span> </span>ELEGOO photopolymer resin</strong><span> </span>is specially designed to minimize volume shrinkage during the photocuring process, guaranteeing high-precision print models with a smooth, impeccable finish. Say goodbye to imperfections and hello to perfection.</p>\n<p><strong>Features:</strong></p>\n<ul>\n<li>\n<strong>Low Shrinkage, High Precision</strong>:<span> </span><strong>ELEGOO’s resin</strong><span> </span>is formulated to minimize volume shrinkage during photocuring, ensuring your prints are remarkably precise. Say goodbye to print imperfections and hello to perfection.</li>\n<li>\n<strong>Fast Curing, Great Stability</strong>: Our 405nm Rapid Resin is engineered for swift curing, significantly reducing your printing time. Experience the benefits of excellent fluidity, coupled with great stability and optimal hardness for worry-free, successful printing.</li>\n<li>\n<strong>Bright and Stunning Colors</strong>: Elevate your 3D prints with vibrant, true-to-life colors. Thanks to our high-quality pigments and photoinitiators, every print is a masterpiece, a true work of art.</li>\n<li>\n<strong>Wide Applications</strong>:<strong><span> </span>ELEGOO Standard Resin</strong><span> </span>is compatible with most DLP/LCD 3D printers. However, it truly shines when paired with LCD 3D printers. From board game miniatures to industrial components,<span> </span><strong>ELEGOO</strong><span> </span>is your versatile partner in bringing ideas to life.</li>\n</ul>","isExclusive":false,"review