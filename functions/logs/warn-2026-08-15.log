://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970816-933376948.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970652-809491093.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970652-809491093.jpg"}],"salePrice":249,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970658-536949068.jpg","isFeatured":false,"category_id":"3493bf57-04fd-4c33-8ca0-59ca179164f6","dealerPrice":249,"description":"<h3 data-end=\"158\" data-start=\"105\"> Heater and Thermistor for Neptune 4 Plus / Max</h3>\n<p data-end=\"434\" data-start=\"160\">This is a <strong data-end=\"233\" data-start=\"170\">replacement heater cartridge and thermistor sensor assembly</strong> designed specifically for the <strong data-end=\"289\" data-start=\"264\">Elegoo Neptune 4 Plus</strong> and <strong data-end=\"311\" data-start=\"294\">Neptune 4 Max</strong> 3D printers. It ensures your printer’s hotend heats quickly, evenly, and accurately detects temperature during printing.</p>\n<h4 data-end=\"453\" data-start=\"436\">📋 Features:</h4>\n<p data-end=\"1014\" data-start=\"454\">✅ Compatible with Elegoo Neptune 4 Plus &amp; 4 Max hotend.<br data-end=\"512\" data-start=\"509\">✅ High-power 24V heater cartridge (commonly 40W–50W) for fast heat-up and stable temperature.<br data-end=\"608\" data-start=\"605\">✅ High-precision NTC thermistor (usually 100K) for accurate temperature reading and thermal protection.<br data-end=\"714\" data-start=\"711\">✅ Pre-wired with the correct connectors for a plug-and-play replacement — no soldering required.<br data-end=\"813\" data-start=\"810\">✅ Durable, heat-resistant cables with protective sleeving for safe, long-term use.<br data-end=\"898\" data-start=\"895\">✅ Ideal for replacing a worn, damaged, or malfunctioning heater or thermistor to restore your printer’s performance.</p>\n<h4 data-end=\"1041\" data-start=\"1016\">📦 Package Includes:</h4>\n<p data-end=\"1079\" data-start=\"1044\">1 × Heater Cartridge (24V, ~40–50W) <br><br>OR</p>\n<p data-end=\"1108\" data-start=\"1082\">1 × Thermistor with wiring</p>\n<p data-end=\"1134\" data-start=\"1111\">Pre-attached connectors</p>\n<h4 data-end=\"1150\" data-start=\"1136\">🔧 Notes:</h4>\n<p data-end=\"1228\" data-start=\"1153\">Always ensure the printer is powered off and unplugged before installation.</p>\n<p data-end=\"1301\" data-start=\"1231\">Check the wiring and connectors match your printer before powering on.</p>\n<p data-end=\"1380\" data-start=\"1304\">Run a PID tuning after replacing the heater for optimal thermal performance.</p>\n<p data-end=\"1541\" data-start=\"1382\">This replacement kit helps maintain consistent extrusion temperature, ensuring high-quality prints and prolonging the life of your Neptune 4 Plus / Max hotend.</p>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970658-536949068.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970658-536949068.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970683-546560837.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970652-809491093.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970816-933376948.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443972353-639858861.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443972351-740034866.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970683-546560837.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970816-933376948.jpg"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970683-546560837.jpg","shortDescription":"<h3 data-end=\"158\" data-start=\"105\"> Heater and Thermistor for Neptune 4 Plus / Max</h3>\n<p data-end=\"434\" data-start=\"160\">This is a <strong data-end=\"233\" data-start=\"170\">replacement heater cartridge and thermistor sensor assembly</strong> designed specifically for the <strong data-end=\"289\" data-start=\"264\">Elegoo Neptune 4 Plus</strong> and <strong data-end=\"311\" data-start=\"294\">Neptune 4 Max</strong> 3D printers. It ensures your printer’s hotend heats quickly, evenly, and accurately detects temperature during printing.</p>\n<h4 data-end=\"453\" data-start=\"436\">📋 Features:</h4>\n<p data-end=\"1014\" data-start=\"454\">✅ Compatible with Elegoo Neptune 4 Plus &amp; 4 Max hotend.<br data-end=\"512\" data-start=\"509\">✅ High-power 24V heater cartridge (commonly 40W–50W) for fast heat-up and stable temperature.<br data-end=\"608\" data-start=\"605\">✅ High-precision NTC thermistor (usually 100K) for accurate temperature reading and thermal protection.<br data-end=\"714\" data-start=\"711\">✅ Pre-wired with the correct connectors for a plug-and-play replacement — no soldering required.<br data-end=\"813\" data-start=\"810\">✅ Durable, heat-resistant cables with protective sleeving for safe, long-term use.<br data-end=\"898\" data-start=\"895\">✅ Ideal for replacing a worn, damaged, or malfunctioning heater or thermistor to restore your printer’s performance.</p>\n<h4 data-end=\"1041\" data-start=\"1016\">📦 Package Includes:</h4>\n<p data-end=\"1079\" data-start=\"1044\">1 × Heater Cartridge (24V, ~40–50W) <br><br>OR</p>\n<p data-end=\"1108\" data-start=\"1082\">1 × Thermistor with wiring</p>\n<p data-end=\"1134\" data-start=\"1111\">Pre-attached connectors</p>\n<h4 data-end=\"1150\" data-start=\"1136\">🔧 Notes:</h4>\n<p data-end=\"1228\" data-start=\"1153\">Always ensure the printer is powered off and unplugged before installation.</p>\n<p data-end=\"1301\" data-start=\"1231\">Check the wiring and connectors match your printer before powering on.</p>\n<p data-end=\"1380\" data-start=\"1304\">Run a PID tuning after replacing the heater for optimal thermal performance.</p>\n<p data-end=\"1541\" data-start=\"1382\">This replacement kit helps maintain consistent extrusion temperature, ensuring high-quality prints and prolonging the life of your Neptune 4 Plus / Max hotend.</p>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970658-536949068.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443970652-809491093.jpg"]},{"id":"0c799c6b-25e5-4512-98e8-d8a8f6c325d2","mrp":1299,"sku":"tri-colour-silk-3d-filament","name":"TRI COLOUR SILK 3D FILAMENT","slug":"tri-colour-silk-3d-filament","brand":"e8665147-633e-4b6d-b462-cbfdc6114665","stock":0,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443972385-387241541.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443972400-128567996.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443982730-785739960.png","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443972386-775130633.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443975755-807517404.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"4ce79209-80fe-45e7-8b05-897e433c0df8","sku":"tri-colo