rder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015378-559264010.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"0a414f9e-261c-44f9-846f-fed546c5fee3","sku":"elegoo-neptune-4-plus-Default Title","name":"Default Title","price":"37999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"10000","isActive":true,"createdAt":"2026-07-19T06:59:23.487Z","deletedAt":null,"isDefault":false,"productId":"0dea1177-8f37-4dbe-af6b-f5ed8fc7a7c5","salePrice":null,"updatedAt":"2026-07-19T06:59:23.487Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg"}],"salePrice":37999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":37999,"description":"<h5>The ELEGOO Neptune 4 Plus is a high-quality 3D printer for professionals and enthusiasts. With its advanced features and precise printing capabilities, it offers a 98% success rate and 50 micrometer print resolution. Take your 3D printing to the next level with the ELEGOO Neptune 4 Plus.</h5>\n<div data-cel-widget=\"productDescription_feature_div\" data-csa-c-id=\"3rme8e-aje279-mcpd6b-aghgf2\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"\" data-csa-c-slot-id=\"productDescription_feature_div\" data-csa-c-content-id=\"productDescription_IN_Ce_display_on_website\" data-csa-c-type=\"widget\" data-feature-name=\"productDescription_IN_Ce_display_on_website\" class=\"celwidget\" id=\"productDescription_feature_div\">\n<div>\n<div data-cel-widget=\"productDescription_feature_div\" class=\"a-row feature\" id=\"productDescription_feature_div\" data-template-name=\"productDescription\" data-feature-name=\"productDescription\">\n<h3 class=\"default\">Product description</h3>\n<div class=\"a-section a-spacing-small\" id=\"productDescription\">\n<h5><span>Elegoo Neptune 4 Plus FDM 3D Printer</span></h5>\n<h5><span>Upto 500mm/s Speed</span></h5>\n<h5><span>Generous Build Volume</span></h5>\n<h5><span>300°C High Temp Nozzle Kit</span></h5>\n<h5><span>Speed Up your printing with Klipper</span></h5>\n<h5><span>Massive space for creation 320x320x385 mm</span></h5>\n<h5><span>Fast and Precise Extrusion</span></h5>\n<h5><span>Comprehensive and Efficient cooling</span></h5>\n<h5><span>Max printing speed: 500 mm/s</span></h5>\n<h5><span>11 x 11 (121) points auto leveling</span></h5>\n<h5><span>Up to 300°C nozzle</span></h5>\n<h5><span class=\"a-text-bold\">Pre-installed Klipper Firmware</span></h5>\n<h5><span>The Neptune 4 Plus comes with the powerful Klipper firmware, enabling impressive printing speeds of up tp 500 mm/s (default 250 mm/s) and up to 12000 mm/s² accelerations, supporting advanced features such as input shaping and pressure advancing.</span></h5>\n<h5><span>Equipped with acceleration sensors on the X and Y axes for automatic calibration and improved print quality.</span></h5>\n<h5><span>The automatic calibration of nozzle PID parameters optimizes nozzle thermal performance and temperature control, ensuring consistent and reliable printing results.</span></h5>\n<h5><span>Versatile Connectivity and Control</span></h5>\n<h5><span>Connect seamlessly with our printer using various options including WIFI, U disk, and LAN connectivity.</span></h5>\n<h5><span>Enjoy the convenience of WEB remote control printing and multi-machine network printing control for effortless management of your printing projects.</span></h5>\n<h5><span>Just start your printing jobs with a one-key file transfer.</span></h5>\n<h5><br></h5>\n</div>\n</div>\n</div>\n</div>\n<div data-cel-widget=\"productDetails_feature_div\" data-csa-c-id=\"bmgrwm-q2f3qa-ya6n1a-11uouj\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"\" data-csa-c-slot-id=\"productDetails_feature_div\" data-csa-c-content-id=\"productDetails_after_aplus\" data-csa-c-type=\"widget\" data-feature-name=\"productDetails_after_aplus\" class=\"celwidget\" id=\"productDetails_feature_div\"><a name=\"productDetails\" id=\"productDetails\"></a></div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012815-965960105.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012905-535750937.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012760-857334629.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444014617-504812194.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015095-19114114.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015378-559264010.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012815-965960105.jpg","shortDescription":"<h5>The ELEGOO Neptune 4 Plus is a high-quality 3D printer for professionals and enthusiasts. With its advanced features and precise printing capabilities, it offers a 98% success rate and 50 micrometer print resolution. Take your 3D printing to the next level with the ELEGOO Neptune 4 Plus.</h5>\n<div data-cel-widget=\"productDescription_feature_div\" data-csa-c-id=\"3rme8e-aje279-mcpd6b-aghgf2\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"\" data-csa-c-slot-id=\"productDescription_feature_div\" data-csa-c-content-id=\"productDescription_IN_Ce_display_on_website\" data-csa-c-type=\"widget\" data-feature-name=\"productDescription_IN_Ce_display_on_website\" class=\"celwidget\" id=\"productDescription_feature_div\">\n<div>\n<div data-cel-widget=\"productDescription_feature_div\" class=\"a-row feature\" id=\"productDescription_feature_div\" data-template-name=\"productDescription\" data-feature-name=\"productDescription\">\n<h3 class=\"default\">Product description</h3>\n<div class=\"a-section a-spacing-small\" id=\"productDescription\">\n<h5><span>Elegoo Neptune 4 Plus FDM 3D Printer</span></h5>\n<h5><span>Upto 500mm/s Speed</span></h5>\n<h5><span>Generous Build Volume</span></h5>\n<h5><span>300°C High Temp Nozzle Kit</span></h5>\n<h5><span>Speed Up your printing with Klipper</span></h5>\n<h5><span>Massive space for creation 320x320x385 mm</span></h5>\n<h5><span>Fast and Precise Extrusion</span></h5>\n<h5><span>Comprehensive and Efficient cooling</span></h5>\n<h5><span>Max printing speed: 500 mm/s</span></h5>\n<h5><span>11 x 11 (121) points auto leveling</span></h5>\n<h5><span>Up to 300°C nozzle</span></h5>\n<h5><span class=\"a-text-bold\">Pre-installed Klipper Firmware</span></h5>\n<h5><span>The Neptune 4 Plus comes with the powerful Klipper firmware, enabling impressive printing speeds of up tp 500 mm/s (default 250 mm/s) and up to 12000 mm/s² accelerations, supporting advanced features such as input shaping and pressure advancing.</span></h5>\n<h5><span>Equipped with acceleration sensors on the X and Y axes for automatic calibration and improved print quality.</span></h5>\n<h5><span>The automatic calibration of nozzle PID parameters optimizes nozzle thermal performance and temperature control, ensuring consistent and reliable printing results.</span></h5>\n<h5><span>Versatile Connectivity and Control</span></h5>\n<h5><span>Connect seamlessly with our printer using various options including WIFI, U disk, and LAN connectivity.</span></h5>\n<h5><span>Enjoy the convenience of WEB remote control printing and multi-machine network printing control for effortless management of your printing projects.</span></h5>\n<h5><span>Just start your printing jobs with a one-key file transfer.</span></h5>\n<h5><br></h5>\n</div>\n</div>\n</div>\n</div>\n<div data-cel-widget=\"productDetails_feature_div\" data-csa-c-id=\"bmgrwm-q2f3qa-ya6n1a-11uouj\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"\" data-csa-c-slot-id=\"productDetails_feature_div\" data-csa-c-content-id=\"productDetails_after_aplus\" data-csa-c-type=\"widget\" data-feature-name=\"productDetails_after_aplus\" class=\"celwidget\" id=\"productDetails_feature_div\"><a name=\"productDetails\" id=\"productDetails\"></a></div>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444012823-900209998.jpg"]},{"id":"337701d3-cd8e-4fb4-a5eb-5b68664f8064","mrp":1699,"sku":"elegoo-standard-photopolymer-high-precision-3d-printer-resin","name":"ELEGOO Standard  Resin","slug":"elegoo-standard-photopolymer-high-precision-3d-printer-resin","brand":"e8665147-633e-4b6d-b462-cbfdc6114665","stock":37,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013732-711830361.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.goog