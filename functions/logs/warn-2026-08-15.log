</span></strong></span></li>\n<li class=\"property-item\" id=\"product-prop-\" data-mce-fragment=\"1\"><span data-mce-fragment=\"1\"><strong data-mce-fragment=\"1\"><span class=\"propery-title\" data-mce-fragment=\"1\">Color: </span><span title=\"silver head(red guide line)\" class=\"propery-des\" data-mce-fragment=\"1\">silver head(red guide line)</span></strong></span></li>\n</ul>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444033649-587664178.jpg"]},{"id":"bd3e640b-52ab-445f-8527-233a820dcb83","mrp":299,"sku":"mk8-extruder-aluminium-block-diy-kit-left-hand","name":"MK8 Extruder kit : Gold left Hand","slug":"mk8-extruder-aluminium-block-diy-kit-left-hand","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":23,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444034990-740246147.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444034995-898356294.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444035127-492800137.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444035004-114765313.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"bb033bbb-d1e2-4adc-918e-5aa5a4db9830","sku":"mk8-extruder-aluminium-block-diy-kit-left-hand-Default Title","name":"Default Title","price":"299","stock":23,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444034990-740246147.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"100","isActive":true,"createdAt":"2026-07-19T07:00:48.619Z","deletedAt":null,"isDefault":false,"productId":"bd3e640b-52ab-445f-8527-233a820dcb83","sale