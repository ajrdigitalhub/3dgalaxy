ting-feat-04-0217.jpg?crop=center&amp;v=1739862101&amp;width=610 610w,//us.elegoo.com/cdn/shop/files/cc-listing-feat-04-0217.jpg?crop=center&amp;v=1739862101&amp;width=1280 1280w,//us.elegoo.com/cdn/shop/files/cc-listing-feat-04-0217.jpg?crop=center&amp;v=1739862101&amp;width=1920 1920w\" alt=\"\" loading=\"lazy\"></div>\n<div class=\"media-grid--content text-left\">\n<div class=\"section-header\">\n<div class=\"section-header--content\">\n<h3 class=\"section-header--title\">Multi-Color Printing</h3>\n</div>\n</div>\n</div>\n</div>\n<div class=\"media-grid--item  media-top mobile-hide  content-middle-left has-link--   big-media\">\n<div class=\"media-grid--bg\"><img class=\"\" width=\"367\" height=\"136\" src=\"https://us.elegoo.com/cdn/shop/files/cc-listing-feat-05-02141100.jpg?v=1751366739&amp;width=345\" srcset=\"//us.elegoo.com/cdn/shop/files/cc-listing-feat-05-02141100.jpg?crop=center&amp;v=1751366739&amp;width=345 345w,//us.elegoo.com/cdn/shop/files/cc-listing-feat-05-02141100.jpg?crop=center&amp;v=1751366739&amp;width=610 610w,//us.elegoo.com/cdn/shop/files/cc-listing-feat-05-02141100.jpg?crop=center&amp;v=1751366739&amp;width=1280 1280w,//us.elegoo.com/cdn/shop/files/cc-listing-feat-05-02141100.jpg?crop=center&amp;v=1751366739&amp;width=1920 1920w\" alt=\"\" loading=\"lazy\"></div>\n<div class=\"media-grid--content text-left\">\n<div class=\"section-header\">\n<div class=\"section-header--content\">\n<h3 class=\"section-header--title\">Chamber Camera</h3>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--17973726904501__image_with_text_overlay_xNnejq\" class=\"shopify-section section-image-with-text-overlay\">\n<div id=\"\" class=\"row section--material-versatility layout-v2\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text-overlay--content content-top-left\">\n<div class=\"image-with-text-overlay--content-inner content-width-medium\">\n<h3 class=\"h1-xlarge\">Redefining Material Versatility</h3>\n<div class=\"rte description-size--medium\">\n<p>Designed for advanced materials, Centauri Carbon is equipped with a 320 °C brass-hardened steel nozzle and superior cooling within a fully enclosed chamber. It specializes in carbon fiber reinforced filament, allowing you to create strong, lightweight and heat-resistant parts, ideal for aerospace, automotive, and athletic applications.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--17973726904501__00f04487-4746-43db-ba40-17f2c42dc0f0\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row image-with-text--layout_compact section--high-speed layout-v2 disable-card\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h3 class=\"h3\">Built for High-Speed</h3>\n<div class=\"rte\">\n<p>Centauri Carbon redefines speed with its advanced CoreXY motion system, reaching up to 500 mm/s and 20,000 mm/s² acceleration. Its 32 mm³/s flow rate enables rapid creation of larger, intricate designs, while the high-power heated bed ensures quick heat-up for instant printing.</p>\n</div>\n<div class=\"image-with-text--icons\">\n<div class=\"image-with-text--icon\">\n<h3>500mm/s Velocity</h3>\n</div>\n<div class=\"image-with-text--icon\">\n<h3>20,000mm/s² Acceleration</h3>\n</div>\n<div class=\"image-with-text--icon\">\n<h3>32 mm³/s Flow rate</h3>\n</div>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"\" width=\"333\" height=\"344\" src=\"https://us.elegoo.com/cdn/shop/files/CC-3-Built-for-High-Speed-630x650_f696fc82-5c27-4dbb-a902-44eb7d2aa7fc.jpg?v=1751366798&amp;width=690\" srcset=\"//us.elegoo.com/cdn/shop/files/CC-3-Built-for-High-Speed-630x650_f696fc82-5c27-4dbb-a902-44eb7d2aa7fc.jpg?crop=center&amp;v=1751366798&amp;width=690 690w,//us.elegoo.com/cdn/shop/files/CC-3-Built-for-High-Speed-630x650_f696fc82-5c27-4dbb-a902-44eb7d2aa7fc.jpg?crop=center&amp;v=1751366798&amp;width=1280 1280w,//us.elegoo.com/cdn/shop/files/CC-3-Built-for-High-Speed-630x650_f696fc82-5c27-4dbb-a902-44eb7d2aa7fc.jpg?crop=center&amp;v=1751366798&amp;width=630 630w\" alt=\"\" loading=\"lazy\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--17973726904501__3c4bd311-db2b-4923-93f4-a04818af9104\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row image-with-text--layout_compact image-with-text--chamber layout-v2 disable-card\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h3 class=\"h3\">Integrated Die-Cast Design</h3>\n<div class=\"rte\">\n<p>We spent extra to bring you the most reliable integrated die-cast aluminum construction, ensuring superior stability and reduced vibrations for high-speed printing. This robust design allows you to achieve faster prints without compromising accuracy or quality.</p>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"\" width=\"316\" height=\"326\" src=\"https://us.elegoo.com/cdn/shop/files/cc-listing-integrated-cast-design-0215_290fcd1a-8d8d-4dc8-991e-df0441ce98b7.jpg?v=1751366816&amp;width=690\" srcset=\"//us.elegoo.com/cdn/shop/files/cc-listing-integrated-cast-design-0215_290fcd1a-8d8d-4dc8-991e-df0441ce98b7.jpg?crop=center&amp;v=1751366816&amp;width=690 690w,//us.elegoo.com/cdn/shop/files/cc-listing-integrated-cast-design-0215_290fcd1a-8d8d-4dc8-991e-df0441ce98b7.jpg?crop=center&amp;v=1751366816&amp;width=1280 1280w,//us.elegoo.com/cdn/shop/files/cc-listing-integrated-cast-design-0215_290fcd1a-8d8d-4dc8-991e-df0441ce98b7.jpg?crop=center&amp;v=1751366816&amp;width=630 630w\" alt=\"\" loading=\"lazy\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--17973726904501__before_after_image_nJdgQx\" class=\"shopify-section section-before-after\">\n<div class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"before-after-image image-position--image_top section-spacing\">\n<div class=\"before-after-image--text\">\n<h3 class=\"h1\">Feel the Smoothness</h3>\n<div class=\"rte\">\n<p>Achieve a perfect first layer with smooth surfaces and stunning details. Centauri Carbon's automatic vibration compensation and pressure advance ensures extra smoothness, bringing you lightning-fast speed without ringing or ghosting in prints. </p>\n</div>\n</div>\n<div class=\"before-after-image--media before-after-image--1\">\n<div class=\"before-after-image--image mobile-height-image desktop-height-650\"><img class=\"\" width=\"309\" height=\"157\" src=\"https://us.elegoo.com/cdn/shop/files/cc-listing-layers-before-021420.jpg?v=1739791423&amp;width=375\" srcset=\"//us.elegoo.com/cdn/shop/files/cc-listing-layers-before-021420.jpg?crop=center&amp;v=1739791423&amp;width=375 375w,//us.elegoo.com/cdn/shop/files/cc-listing-layers-before-021420.jpg?crop=center&amp;v=1739791423&amp;width=1920 1920w\" alt=\"\" loading=\"lazy\"></div>\n<div class=\"before-after-image--content before-after-image--content-top\">\n<div class=\"before-after-image--label before-after-image--label-h3\">Before</div>\n</div>\n</div>\n<div class=\"before-after-image--media before-after-image--2\">\n<div class=\"before-after-image--image mobile-height-image desktop-height-650\"><img class=\"\" width=\"309\" height=\"157\" src=\"https://us.elegoo.com/cdn/shop/files/cc-listing-layers-after-021420.jpg?v=1739791424&amp;width=375\" srcset=\"//us.elegoo.com/cdn/shop/files/cc-listing-layers-after-021420.jpg?crop=center&amp;v=1739791424&amp;width=375 375w,//us.elegoo.com/cdn/shop/files/cc-listing-layers-after-021420.jpg?crop=center&amp;v=1739791424&amp;width=1920 1920w\" alt=\"\" loading=\"lazy\"></div>\n<div class=\"before-after-image--content before-after-image--content-top\">\n<div class=\"before-after-image--label before-after-image--label-h3\">After</div>\n</div>\n</div>\n<div class=\"before-after-image--divider\"><svg width=\"40\" height=\"54\" viewbox=\"0 0 40 54\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"40\" height=\"54\" rx=\"20\" fill=\"var(--color-line, --color-accent)\"></rect><rect x=\"14\" y=\"20\" width=\"1.56522\" height=\"14\" rx=\"0.782609\" fill=\"var(--bg-body)\"></rect><rect x=\"19.2173\" y=\"20\" width=\"1.56522\" height=\"14\" rx=\"0.782609\" fill=\"var(--bg-body)\"></rect><rect x=\"24.4348\" y=\"20\" width=\"1.56522\" height=\"14\" rx=\"0.782609\" fill=\"var(--bg-body)\"></rect></svg></div>\n<input type=\"range\" min=\"0\" max=\"1000\" value=\"500\" class=\"before-after-image--slider\">\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--17973726904501__01e5aef7-91b9-4e05-b430-c86652a9aff5\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row image-with-text--layout_compact\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h3 class=\"h3\">Chamber Camera Keeps You in Total Control</h3>\n<div class=\"rte\">\n<p>The chamber camera offers real-time monitoring for quick adjustments, minimizing waste and enhancing reliability. The dual built-in LED strips ensure you never miss a moment, while the time-lapse feature makes sharing your creative process a breeze.</p>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"\" width=\"283\" height=\"292\" src=\"https://us.elegoo.com/cdn/shop/files/CC-3-Chamber-Camera-630x650_9915bd70-cf6c-4db4-95ca-319a7ca3788e.jpg?v=1751366833&amp;width=690\" srcset=\"//us.elegoo.com/cdn/shop/files/CC-3-Chamber-Camera-630x650_9915bd70-cf6c-4db4-95ca-319a7ca3788e.jpg?crop=center&amp;v=1751366833&amp;width=690 690w,//us.elegoo.com/cdn/shop/files/CC-3-Chamber-Camera-630x650_9915bd70-cf6c-4db4-95ca-319a7ca3788e.jpg?crop=center&amp;v=1751366833&amp;width=1280 1280w,//us.elegoo.com/cdn/shop/files/CC-3-Chamber-Camera-630x650_9915bd70-cf6c-4db4-95ca-319a7ca3788e.jpg?crop=center&amp;v=1751366833&amp;width=630 630w\" alt=\"\" loading=\"lazy\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--17973726904501__image_with_text_7ti6wt\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row image-with-text--layout_compact\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h3 class=\"h1\">Dual-Sided Flexible Plate</h3>\n<div class=\"rte\">\n<p>The upgraded dual-sided plate features a new PLA Specific Surface with excellent adhesion and minimal warping, ensuring perfect PLA printing even at lower heatbed temperatures.</p>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"\" width=\"293\" height=\"302\" src=\"https://us.elegoo.com/cdn/shop/files/CC-3-Dual-Sided-Flexible-Plate-630x650_7c806623-fc5b-4178-ad50-419d85da097c.jpg?v=1751366851&amp;width=690\" srcset=\"//us.ele