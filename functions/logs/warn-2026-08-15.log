76-33614436.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"440bc2f4-247a-4a4d-866e-0489268ca62f","sku":"anycubic-water-wash-resin-2-0-1kg-clear","name":"clear","price":"1999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-22T07:54:58.284Z","deletedAt":null,"isDefault":false,"productId":"17942f58-ae23-41f3-a185-4749d4cb1309","salePrice":null,"updatedAt":"2026-07-22T07:54:58.284Z","variantSlug":null,"optionValues":{"Color":"clear"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp"},{"id":"727dd83e-4af6-4354-8096-d366707a0994","sku":"anycubic-water-wash-resin-2-0-1kg-white","name":"white","price":"1999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-22T07:54:58.591Z","deletedAt":null,"isDefault":false,"productId":"17942f58-ae23-41f3-a185-4749d4cb1309","salePrice":null,"updatedAt":"2026-07-22T07:54:58.591Z","variantSlug":null,"optionValues":{"Color":"white"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"}],"salePrice":1999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","isFeatured":true,"category_id":"6bc58c59-9787-4fcd-bac2-8cc779a56e60","dealerPrice":1999,"description":"<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Version 2.0 formula — stronger, faster, more stable</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Water washable — no alcohol needed</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>HD gray color enhances detail visibility</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Low shrinkage and low odor</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Compatible with 365–405 nm UV printers<br></p>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Super Easy to Clean】Anycubic Water Washable Resin 2.0 contains hydrophilic groups with good water solubility, which is can be directly cleaned with water instead of alcohol and greatly save the cost of alcohol use. Besides, it can also be cleaned by Anycubic Wash and Cure Machine or ultrasonic cleaning.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Anti-Yellowing &amp; Stay Vibrant】The upgraded formula for Anycubic Water Washable Resin 2.0 ensures models retain vibrant colors even after prolonged exposure, a breakthrough particularly effective for White and Transparent resins.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Lower Shrinkage Rate &amp; High Precision Models】With a precision of up to 0.15mm, Anycubic Water Washable Resin 2.0 perfectly meets the extreme demands for detail in miniature models.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High-Resilience &amp; Less Prone to Cracking】 An impressive elongation rate of 16.62% ensures cured models are highly flexible, long lasting and resistant to cracking.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Less Odor for Indoor Use】 The optimized formula making Anycubic 3D Printer Resin Water Washable significantly reduces resin odor during storage and printing, ensuring a more comfortable printing experience.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Low Viscosity &amp; High Print Success Rates】The enhanced platform adhesion provides stable, high quality prints with high print success rates.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Compatibility】 Anycubic Water Washable Resin 2.0 is compatible with a wide range of LCD and DLP 3D printers operating within the 365-405nm wavelength, our resin offers seamless integration with most printers on the market.</li>\n</ul>\n</div>\n</div>\n</div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875043-588113816.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875291-907681875.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877379-27569333.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877476-33614436.webp"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp","shortDescription":"<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Version 2.0 formula — stronger, faster, more stable</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Water washable — no alcohol needed</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>HD gray color enhances detail visibility</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Low shrinkage and low odor</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>Compatible with 365–405 nm UV printers<br></p>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Super Easy to Clean】Anycubic Water Washable Resin 2.0 contains hydrophilic groups with good water solubility, which is can be directly cleaned with water instead of alcohol and greatly save the cost of alcohol use. Besides, it can also be cleaned by Anycubic Wash and Cure Machine or ultrasonic cleaning.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Anti-Yellowing &amp; Stay Vibrant】The upgraded formula for Anycubic Water Washable Resin 2.0 ensures models retain vibrant colors even after prolonged exposure, a breakthrough particularly effective for White and Transparent resins.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Lower Shrinkage Rate &amp; High Precision Models】With a precision of up to 0.15mm, Anycubic Water Washable Resin 2.0 perfectly meets the extreme demands for detail in miniature models.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High-Resilience &amp; Less Prone to Cracking】 An impressive elongation rate of 16.62% ensures cured models are highly flexible, long lasting and resistant to cracking.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Less Odor for Indoor Use】 The optimized formula making Anycubic 3D Printer Resin Water Washable significantly reduces resin odor during storage and printing, ensuring a more comfortable printing experience.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Low Viscosity &amp; High Print Success Rates】The enhanced platform adhesion provides stable, high quality prints with high print success rates.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Compatibility】 Anycubic Water Washable Resin 2.0 is compatible with a wide range of LCD and DLP 3D printers operating within the 365-405nm wavelength, our resin offers seamless integration with most printers on the market.</li>\n</ul>\n</div>\n</div>\n</div>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874997-76478336.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875001-939514494.webp"]}],"gradientSettings":{},"homePageSections":{"brands":[],"bestSellers":[],"featuredProducts":[],"featuredCategories":[]},"shippingSettings":{"defaultShippingCharge":1,"enableProductShipping":true,"freeShippingThreshold":3500,"enableCategoryShipping":true,"enableWeightBasedShipping":true,"weightRules":[]},"trendingProducts":[{"id":"1295f67c-fc74-4249-ac2e-a5cb96e86744","mrp":1799,"sku":"elegoo-water-washable-resin-v2-0","name":"ELEGOO Water-Washable Resin V2.0","slug":"elegoo-water-washable-resin-v2-0","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":20,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875021-128968985.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877568-87252057.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443878284-337574258.w