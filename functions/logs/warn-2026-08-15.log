2189\" data-end=\"2236\">\n<p data-start=\"2191\" data-end=\"2236\">Functional prototypes with varied materials</p>\n</li>\n<li data-start=\"2237\" data-end=\"2312\">\n<p data-start=\"2239\" data-end=\"2312\">Engineering components requiring different properties in a single print</p>\n</li>\n<li data-start=\"2313\" data-end=\"2360\">\n<p data-start=\"2315\" data-end=\"2360\">Hobby projects with advanced visual effects</p>\n</li>\n</ul>","mrp":24175,"salePrice":24175,"dealerPrice":24175,"stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443912695-595644022.png","isPrimary":false,"isSecondary":false,"sortOrder":0},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443916643-639881789.png","isPrimary":false,"isSecondary":false,"sortOrder":0},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443926293-798990921.png","isPrimary":false,"isSecondary":false,"sortOrder":0}],"variants":[],"isFeatured":false,"isExclusive":false,"codAvailable":true,"rating":0,"reviewCount":0,"categoryId":null,"categoryIds":[],"categories":[],"primaryCategory":null,"weightInGrams":0,"weightUnit":"g","reviews":[],"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443912695-595644022.png","secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443916643-639881789.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443912695-595644022.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443916643-639881789.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443926293-798990921.png"],"hasVariants":false,"variantImages":[],"variantSecondaryImages":[],"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443912695-