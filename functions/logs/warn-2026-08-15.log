443874987-186512522.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp"},{"id":"e5849777-7421-4265-af58-71a5c1403948","sku":"elegoo-water-washable-resin-v2-0-mint-green-1","name":"mint-green-1","price":"1799","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1200","isActive":true,"createdAt":"2026-07-19T06:54:53.552Z","deletedAt":null,"isDefault":false,"productId":"1295f67c-fc74-4249-ac2e-a5cb96e86744","salePrice":null,"updatedAt":"2026-07-19T06:54:53.552Z","variantSlug":null,"optionValues":{"Color":"mint-green-1"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp"}],"salePrice":1799,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","isFeatured":false,"category_id":"6bc58c59-9787-4fcd-bac2-8cc779a56e60","dealerPrice":1799,"description":"<h1><span>ELEGOO Water-Washable Resin V2.0</span></h1>\n<p><span>Experience cleaner and more convenient 3D printing with </span><strong><span>ELEGOO Water-Washable Resin V2.0</span></strong><span>. Designed for LCD and DLP resin 3D printers operating at 405 nm, this upgraded resin delivers exceptional print quality while simplifying post-processing with water instead of alcohol.<br><br><img src=\"https://protomont.com/wp-content/uploads/2025/07/imgi_238_ELEGOO-Water-Washable-V2.0-3D-Printer-Resin-PC.jpeg\" alt=\"ELEGOO Water-Washable Resin V2.0\" width=\"428\" height=\"218\"></span><br></p>\n<h3>Key Features of ELEGOO Water-Washable Resin V2.0</h3>\n<p><strong>1. Water-Washable Formula</strong><span> </span>No more chemical hassles. This resin can be easily rinsed with ordinary tap water, making post-processing safer and more convenient. Ideal for homes, schools, and office setups.</p>\n<p><strong>2. High Print Precision</strong><span> </span>The low viscosity and refined chemical composition of ELEGOO Water-Washable Resin V2.0 enable the printing of extremely fine details. Your miniatures, engineering models, and design prototypes come out with sharp features and minimal distortion.</p>\n<p><strong>3. Fast UV Curing</strong><span> </span>Designed for use with 405nm UV light, the resin cures quickly and efficiently, improving production time without sacrificing quality. A great option for batch printing and time-sensitive projects.</p>\n<p><strong>4. Low Odor and Safer for Indoor Use</strong><span> </span>Unlike conventional resins that emit strong chemical smells, ELEGOO’s upgraded formula ensures a more pleasant printing experience, even in enclosed workspaces.</p>\n<p><strong>5. Broad Compatibility</strong><span> </span>ELEGOO Water-Washable Resin V2.0 is compatible with a wide range of 3D printers, including:<span> </span><strong>ELEGOO Mars, Saturn, Jupiter Series,<span> </span></strong><strong>Anycubic Photon Mono, M3, M5 Series,<span> </span></strong><strong>Phrozen Series,<span> </span></strong><strong>Creality Series and<span> </span></strong><strong>Other LCD, MSLA, and DLP printers using 405nm UV wavelength<br></strong><br></p>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","galleryImages":["https://storage.go