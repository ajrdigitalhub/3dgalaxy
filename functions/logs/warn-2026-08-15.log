/ajr3dgalaxy.firebasestorage.app/product-import/1784443954549-968539158.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"3745f73e-df17-42ad-93d1-1565f19fb46a","sku":"3d-galaxy-abs-like-resin-Default Title","name":"Default Title","price":"1799","stock":3,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1000","isActive":true,"createdAt":"2026-07-19T06:57:18.474Z","deletedAt":null,"isDefault":false,"productId":"3309b851-343a-4c04-bd23-7a9afa0f5715","salePrice":null,"updatedAt":"2026-07-19T06:57:18.474Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png"}],"salePrice":1799,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png","isFeatured":false,"category_id":"55a711ea-3f62-443b-9b00-dc8d361e5cac","dealerPrice":1799,"description":"<h3 data-start=\"115\" data-end=\"175\"><strong data-start=\"119\" data-end=\"173\">3D Galaxy ABS-Like UV Sensitive Resin – Gray (1kg)</strong></h3>\n<p data-start=\"177\" data-end=\"494\">Achieve exceptional print quality and durability with <strong data-start=\"231\" data-end=\"272\">3D Galaxy ABS-Like UV Sensitive Resin</strong>. Specially formulated for LCD/DLP 3D printers, this resin delivers high precision, smooth surface finish, and ABS-like toughness, making it perfect for functional prototypes, engineering models, and detailed miniatures.</p>\n<h4 data-start=\"496\" data-end=\"520\"><strong data-start=\"501\" data-end=\"518\">Key Features:</strong></h4>\n<ul data-start=\"521\" data-end=\"1034\">\n<li data-start=\"521\" data-end=\"553\">\n<p data-start=\"523\" data-end=\"553\"><strong data-start=\"523\" data-end=\"536\">Material:</strong> ABS-Like Resin</p>\n</li>\n<li data-start=\"554\" data-end=\"573\">\n<p data-start=\"556\" data-end=\"573\"><strong data-start=\"556\" data-end=\"566\">Color:</strong> Gray</p>\n</li>\n<li data-start=\"574\" data-end=\"600\">\n<p data-start=\"576\" data-end=\"600\"><strong data-start=\"576\" data-end=\"587\">Weight:</strong> 1kg bottle</p>\n</li>\n<li data-start=\"601\" data-end=\"687\">\n<p data-start=\"603\" data-end=\"687\"><strong data-start=\"603\" data-end=\"638\">High Precision &amp; Smooth Finish:</strong> Produces detailed, sharp, and accurate prints.</p>\n</li>\n<li data-start=\"688\" data-end=\"791\">\n<p data-start=\"690\" data-end=\"791\"><strong data-start=\"690\" data-end=\"712\">ABS-Like Strength:</strong> Strong mechanical properties with excellent toughness and impact resistance.</p>\n</li>\n<li data-start=\"792\" data-end=\"864\">\n<p data-start=\"794\" data-end=\"864\"><strong data-start=\"794\" data-end=\"812\">Low Shrinkage:</strong> Ensures dimensional accuracy and minimal warping.</p>\n</li>\n<li data-start=\"865\" data-end=\"947\">\n<p data-start=\"867\" data-end=\"947\"><strong data-start=\"867\" data-end=\"883\">Fast Curing:</strong> Optimized for efficient printing with shorter exposure times.</p>\n</li>\n<li data-start=\"948\" data-end=\"1034\">\n<p data-start=\"950\" data-end=\"1034\"><strong data-start=\"950\" data-end=\"973\">Wide Compatibility:</strong> Works seamlessly with most LCD/DLP 3D printers (405nm UV).</p>\n</li>\n</ul>\n<h4 data-start=\"1036\" data-end=\"1060\"><strong data-start=\"1041\" data-end=\"1058\">Applications:</strong></h4>\n<ul data-start=\"1061\" data-end=\"1229\">\n<li data-start=\"1061\" data-end=\"1102\">\n<p data-start=\"1063\" data-end=\"1102\">Engineering and functional prototypes</p>\n</li>\n<li data-start=\"1103\" data-end=\"1140\">\n<p data-start=\"1105\" data-end=\"1140\">Miniatures, models, and figurines</p>\n</li>\n<li data-start=\"1141\" data-end=\"1191\">\n<p data-start=\"1143\" data-end=\"1191\">Durable parts requiring strength and precision</p>\n</li>\n<li data-start=\"1192\" data-end=\"1229\">\n<p data-start=\"1194\" data-end=\"1229\">Educational and research projects</p>\n</li>\n</ul>\n<h4 data-start=\"1231\" data-end=\"1250\"><strong data-start=\"1236\" data-end=\"1248\">Caution:</strong></h4>\n<ul data-start=\"1251\" data-end=\"1425\">\n<li data-start=\"1251\" data-end=\"1277\">\n<p data-start=\"1253\" data-end=\"1277\">Shake well before use.</p>\n</li>\n<li data-start=\"1278\" data-end=\"1320\">\n<p data-start=\"1280\" data-end=\"1320\">Wear gloves and a mask while handling.</p>\n</li>\n<li data-start=\"1321\" data-end=\"1378\">\n<p data-start=\"1323\" data-end=\"1378\">Store in a cool, dry place away from direct sunlight.</p>\n</li>\n<li data-start=\"1379\" data-end=\"1425\">\n<p data-start=\"1381\" data-end=\"1425\">Post-cure under UV light for best results.</p>\n</li>\n</ul>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954549-968539158.png"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954250-933876380.png"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443954549-968539158.png","shortDescription