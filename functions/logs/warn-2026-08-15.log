y.firebasestorage.app/product-import/1784443874987-186512522.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1200","isActive":true,"createdAt":"2026-07-19T06:54:53.003Z","deletedAt":null,"isDefault":false,"productId":"1295f67c-fc74-4249-ac2e-a5cb96e86744","salePrice":null,"updatedAt":"2026-07-19T06:54:53.003Z","variantSlug":null,"optionValues":{"Color":"ceramic-grey"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp"},{"id":"e5849777-7421-4265-af58-71a5c1403948","sku":"elegoo-water-washable-resin-v2-0-mint-green-1","name":"mint-green-1","price":"1799","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1200","isActive":true,"createdAt":"2026-07-19T06:54:53.552Z","deletedAt":null,"isDefault":false,"productId":"1295f67c-fc74-4249-ac2e-a5cb96e86744","salePrice":null,"updatedAt":"2026-07-19T06:54:53.552Z","variantSlug":null,"optionValues":{"Color":"mint-green-1"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp"}],"salePrice":1799,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","isFeatured":false,"category_id":"6bc58c59-9787-4fcd-bac2-8cc779a56e60","dealerPrice":1799,"description":"<h1><span>ELEGOO Water-Washable Resin V2.0</span></h1>\n<p><span>Experience cleaner and more convenient 3D printing with </span><strong><span>ELEGOO Water-Washable Resin V2.0</span></strong><span>. Designed for LCD and DLP resin 3D printers operating at 405 nm, this upgraded resin delivers exceptional print quality while simplifying post-processing with water instead of alcohol.<br><br><img src=\"https://protomont.com/wp-content/uploads/2025/07/imgi_238_ELEGOO-Water-Washable-V2.0-3D-Printer-Resin-PC.jpeg\" alt=\"ELEGOO Water-Washable Resin V2.0\" width=\"428\" height=\"218\"></span><br></p>\n<h3>Key Features of ELEGOO Water-Washable Resin V2.0</h3>\n<p><strong>1. Water-Washable Formula</strong><span> </span>No more chemical hassles. This resin can be easily rinsed with ordinary tap water, making post-processing safer and more convenient. Ideal for homes, schools, and office setups.</p>\n<p><strong>2. High Print Precision</strong><span> </span>The low viscosity and refined chemical composition of ELEGOO Water-Washable Resin V2.0 enable the printing of extremely fine details. Your miniatures, engineering models, and design prototypes come out with sharp features and minimal distortion.</p>\n<p><strong>3. Fast UV Curing</strong><span> </span>Designed for use with 405nm UV light, the resin cures quickly and efficiently, improving production time without sacrificing quality. A great option for batch printing and time-sensitive projects.</p>\n<p><strong>4. Low Odor and Safer for Indoor Use</strong><span> </span>Unlike conventional resins that emit strong chemical smells, ELEGOO’s upgraded formula ensures a more pleasant printing experience, even in enclosed workspaces.</p>\n<p><strong>5. Broad Compatibility</strong><span> </span>ELEGOO Water-Washable Resin V2.0 is compatible with a wide range of 3D printers, including:<span> </span><strong>ELEGOO Mars, Saturn, Jupiter Series,<span> </span></strong><strong>Anycubic Photon Mono, M3, M5 Series,<span> </span></strong><strong>Phrozen Series,<span> </span></strong><strong>Creality Series and<span> </span></strong><strong>Other LCD, MSLA, and DLP printers using 405nm UV wavelength<br></strong><br></p>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875021-128968985.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877568-87252057.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443878284-337574258.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443878590-673575999.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443878891-829110286.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443879694-363552588.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443881190-290810598.webp"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875021-128968985.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875021-128968985.webp","shortDescription":"<h1><span>ELEGOO Water-Washable Resin V2.0</span></h1>\n<p><span>Experience cleaner and more convenient 3D printing with </span><strong><span>ELEGOO Water-Washable Resin V2.0</span></strong><span>. Designed for LCD and DLP resin 3D printers operating at 405 nm, this upgraded resin delivers exceptional print quality while simplifying post-processing with water instead of alcohol.<br><br><img src=\"https://protomont.com/wp-content/uploads/2025/07/imgi_238_ELEGOO-Water-Washable-V2.0-3D-Printer-Resin-PC.jpeg\" alt=\"ELEGOO Water-Washable Resin V2.0\" width=\"428\" height=\"218\"></span><br></p>\n<h3>Key Features of ELEGOO Water-Washable Resin V2.0</h3>\n<p><strong>1. Water-Washable Formula</strong><span> </span>No more chemical hassles. This resin can be easily rinsed with ordinary tap water, making post-processing safer and more convenient. Ideal for homes, schools, and office setups.</p>\n<p><strong>2. High Print Precision</strong><span> </span>The low viscosity and refined chemical composition of ELEGOO Water-Washable Resin V2.0 enable the printing of extremely fine details. Your miniatures, engineering models, and design prototypes come out with sharp features and minimal distortion.</p>\n<p><strong>3. Fast UV Curing</strong><span> </span>Designed for use with 405nm UV light, the resin cures quickly and efficiently, improving production time without sacrificing quality. A great option for batch printing and time-sensitive projects.</p>\n<p><strong>4. Low Odor and Safer for Indoor Use</strong><span> </span>Unlike conventional resins that emit strong chemical smells, ELEGOO’s upgraded formula ensures a more pleasant printing experience, even in enclosed workspaces.</p>\n<p><strong>5. Broad Compatibility</strong><span> </span>ELEGOO Water-Washable Resin V2.0 is compatible with a wide range of 3D printers, including:<span> </span><strong>ELEGOO Mars, Saturn, Jupiter Series,<span> </span></strong><strong>Anycubic Photon Mono, M3, M5 Series,<span> </span></strong><strong>Phrozen Series,<span> </span></strong><strong>Creality Series and<span> </span></strong><strong>Other LCD, MSLA, and DLP printers using 405nm UV wavelength<br></strong><br></p>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875009-332119550.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875021-128968985.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874987-186512522.webp","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875052-3164479.webp"]},{"id":"bed6873a-a3de-4f9b-bf58-4734041b8faf","mrp":48999,"sku":"bambu-lab-a2l-3d-printer","name":"Bambu Lab A2L 3D Printer","slug":"bambu-lab-a2l-3d-printer","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":0,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875049-16128584.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875058-430881431.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875077-736615886.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877394-359069312.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877816-972620528.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877509-618420696.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877782-693965162.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443879875-755146060.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"d27196c5-17f9-405d-86db-7b81bd8529a5","sku":"bambu-lab-a2l-3d-printer-Default Title","name":"Default Title","price":"48999","stock":0,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"20000","isActive":true,"createdAt":"2026-07-19T06:54:58.064Z","deletedAt":null,"isDefault":false,"productId":"bed6873a-a3de-4f9b-bf58-4734041b8faf","salePrice":null,"updatedAt":"2026-07-19T06:54:58.064Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg"}],"salePrice":48999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":48999,"description":"<p>The<span> </span><strong>Bambu Lab A2L 3D Printer</strong><span> </span>is a powerful large-format 3D printer designed for makers, professionals, educators, and businesses seeking exceptional print quality with minimal setup. Featuring an expansive<span> </span><strong>330 x 320 x 325 mm build volume</strong>, the A2L provides over 105% more printing space than standard 256 mm printers, allowing users to create larger models, functional prototypes, cosplay props, and batch productions in a single print. Its<span> </span><strong>Full-Auto Calibration</strong><span> </span>system automatically handles bed leveling, flow calibration, and vibration compensation, ensuring reliable and consistent results right out of the box.</p>\n<p>Built for advanced multi-color and multi-material printing, the A2L seamlessly integrates with<span> </span><strong>Bambu Lab AMS systems</strong>, supporting up to<span> </span><strong>19-color printing</strong>, filament drying, and enclosed filament storage. Equipped with intelligent print monitoring, adaptive vibration compensation, ultra-quiet operation, and optional modular add-ons for blade cutting and pen plotting, the Bambu Lab A2L delivers a versatile, high-performance 3D printing experience for both creative and professional applications.<br></p>\n<p><strong>Key Features</strong></p>\n<ul>\n<li>\n<strong>EXPANDED LARGE-FORMAT BUILD VOLUME</strong><span> </span>– Massive 330 x 320 x 325 mm build area provides 105% more printing space than standard 256 mm printers, allowing larger models and batch production in a single print.</li>\n<li>\n<strong>FULL-AUTOMATIC CALIBRATION SYSTEM</strong><span> </span>– Automatically performs bed leveling, flow dynamics calibration, vibration compensation, and nozzle offset adjustment for effortless setup and consistent print quality.</li>\n<li>\n<strong>MULTI-COLOR &amp; MULTI-MATERIAL PRINTING</strong><span> </span>– Compatible with Bambu Lab AMS Lite and 2nd Generation AMS systems, supporting advanced multi-color printing, filament drying, enclosed storage, and up to 19-color printing capabilities.</li>\n<li>\n<strong>ADAPTIVE VIBRATION COMPENSATION TECHNOLOGY</strong><span> </span>– Continuously analyzes printer dynamics throughout the print process to minimize ringing, ghosting, and layer artifacts for exceptional surface quality.</li>\n<li>\n<strong>MODULAR FABRICATION PLATFORM</strong><span> </span>– Supports optional blade cutting and pen plotting modules, transforming the printer into a versatile creative workstation beyond standard 3D printing.</li>\n<li>\n<strong>INTELLIGENT PRINT FAILURE DETECTION</strong><span> </span>– Advanced sensors monitor filament flow, tangles, runout, nozzle clogs, and extrusion issues, automatically pausing prints and notifying users through the Bambu Handy app.</li>\n<li>\n<strong>UL CERTIFIED LOW-EMISSION PRINTING</strong><span> </span>– UL 2904 GREENGUARD certified for indoor air quality when used with official Bambu Lab filaments, making it suitable for homes, classrooms, and offices.</li>\n<li>\n<strong>ULTRA-QUIET OPERATION</strong><span> </span>– Active motor noise cancellation, intelligent fan management, and precision motion components enable operation as low as 49 dB in Silent Mode.</li>\n<li>\n<strong>SMART CONNECTIVITY &amp; PRIVACY CONTROL</strong><span> </span>– Choose between Bambu Cloud connectivity for remote monitoring and management or LAN-only mode for secure local-network operation.</li>\n<li>\n<strong>MAKERWORLD ECOSYSTEM INTEGRATION</strong><span> </span>– Access millions of ready-to-print models and streamlined workflows through the MakerWorld ecosystem, accelerating project creation from idea to finished print.<br><br><img src=\"https://wol3d.blr1.cdn.digitaloceanspaces.com/wp-content/uploads/2026/06/02141950/6-1.jpg\" alt=\"Bambu Lab A2L 3D Printer - Image 6\" width=\"423\" height=\"563\"><br><img src=\"https://wol3d.blr1.cdn.digitaloceanspaces.com/wp-content/uploads/2026/06/02141947/7-1.jpg\" alt=\"Bambu Lab A2L 3D Printer - Image 7\" width=\"423\" height=\"563\"><br><img src=\"https://wol3d.blr1.cdn.digitaloceanspaces.com/wp-content/uploads/2026/06/02141958/2-1.jpg\" width=\"423\" height=\"563\"><br>\n</li>\n</ul>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875049-16128584.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875058-430881431.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875077-736615886.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877394-359069312.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877816-972620528.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877509-618420696.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443877782-693965162.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443879875-755146060.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443875049-16128584.jpg","shortDescription":"<p>The<span> </span><strong>Bambu Lab A2L 3D Printer</strong><span> </span>is a powerful large-format 3D printer designed for makers, professionals, educators, and businesses seeking exceptional print quality with minimal setup. Featuring an expansive<span> </span><strong>330 x 320 x 325 mm build volume</strong>, the A2L provides over 105% more printing space than standard 256 mm printers, allowing users to create larger models, functional prototypes, cosplay props, and batch productions in a single print. Its<span> </span><strong>Full-Auto Calibration</strong><span> </span>system automatically handles bed leveling, flow calibration, and vibration compensation, ensuring reliable and consistent results right out of the box.</p>\n<p>Built for advanced multi-color and multi-material printing, the A2L seamlessly integrates with<span> </span><strong>Bambu Lab AMS systems</strong>, supporting up to<span> </span><strong>19-color printing</strong>, filament drying, and enclosed filament storage. Equipped with intelligent print monitoring, adaptive vibration compensation, ultra-quiet operation, and optional modular add-ons for blade cutting and pen plotting, the Bambu Lab A2L delivers a versatile, high-performance 3D printing experience for both creative and professional applications.<br></p>\n<p><strong>Key Features</strong></p>\n<ul>\n<li>\n<strong>EXPANDED LARGE-FORMAT BUILD VOLUME</strong><span> </span>– Massive 330 x 320 x 325 mm build area provides 105% more printing space than standard 256 mm printers, allowing larger models and batch production in a single print.</li>\n<li>\n<strong>FULL-AUTOMATIC CALIBRATION SYSTEM</strong><span> </span>– Automatically performs bed leveling, flow dynamics calibration, vibration compensation, and nozzle offset adjustment for effortless setup and consistent print quality.</li>\n<li>\n<strong>MULTI-COLOR &amp; MULTI-MATERIAL PRINTING</strong><span> </span>– Compatible with Bambu Lab AMS Lite and 2nd Generation AMS systems, supporting advanced multi-color printing, filament drying, enclosed storage, and up to 19-color printing capabilities.</li>\n<li>\n<strong>ADAPTIVE VIBRATION COMPENSATION TECHNOLOGY</strong><span> </span>– Continuously analyzes printer dynamics throughout the print process to minimize ringing, ghosting, and layer artifacts for exceptional surface quality.</li>\n<li>\n<strong>MODULAR FABRICATION PLATFORM</strong><span> </span>– Supports optional blade cutting and pen plotting modules, transforming the printer into a versatile creative workstation beyond standard 3D printing.</li>\n<li>\n<strong>INTELLIGENT PRINT FAILURE DETECTION</strong><span> </span>– Advanced sensors monitor filament flow, tangles, runout, nozzle clogs, and extrusion issues, automatically pausing prints and notifying users through the Bambu Handy app.</li>\n<li>\n<strong>UL CERTIFIED LOW-EMISSION PRINTING</strong><span> </span>– UL 2904 GREENGUARD certified for indoor air quality when used with official Bambu Lab filaments, making it suitable for homes, classrooms, and offices.</li>\n<li>\n<strong>ULTRA-QUIET OPERATION</strong><span> </span>– Active motor noise cancellation, intelligent fan management, and precision motion components enable operation as low as 49 dB in Silent Mode.</li>\n<li>\n<strong>SMART CONNECTIVITY &amp; PRIVACY CONTROL</strong><span> </span>– Choose between Bambu Cloud connectivity for remote monitoring and management or LAN-only mode for secure local-network operation.</li>\n<li>\n<strong>MAKERWORLD ECOSYSTEM INTEGRATION</strong><span> </span>– Access millions of ready-to-print models and streamlined workflows through the MakerWorld ecosystem, accelerating project creation from idea to finished print.<br><br><img src=\"https://wol3d.blr1.cdn.digitaloceanspaces.com/wp-content/uploads/2026/06/02141950/6-1.jpg\" alt=\"Bambu Lab A2L 3D Printer - Image 6\" width=\"423\" height=\"563\"><br><img src=\"https://wol3d.blr1.cdn.digitaloceanspaces.com/wp-content/uploads/2026/06/02141947/7-1.jpg\" alt=\"Bambu Lab A2L 3D Printer - Image 7\" width=\"423\" height=\"563\"><br><img src=\"https://wol3d.blr1.cdn.digitaloceanspaces.com/wp-content/uploads/2026/06/02141958/2-1.jpg\" width=\"423\" height=\"563\"><br>\n</li>\n</ul>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443874402-983798111.jpg"]},{"id":"1531a0af-7645-409a-94c6-d9853ca460a8","mrp":132999,"sku":"bambu-lab-x2d-3d-printer","name":"Bambu Lab X2D 3D Printer","slug":"bambu-lab-x2d-3d-printer","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":4,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880390-740022556.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880392-156103058.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443882091-827027776.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443882176-472010121.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"221a10a7-b4ee-474e-ae07-f8786967d6d4","sku":"bambu-lab-x2d-3d-printer-Bambu Lab X2D 3D Printer","name":"Bambu Lab X2D 3D Printer","price":"98999","stock":2,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-19T06:54:59.946Z","deletedAt":null,"isDefault":false,"productId":"1531a0af-7645-409a-94c6-d9853ca460a8","salePrice":null,"updatedAt":"2026-07-19T06:54:59.946Z","variantSlug":null,"optionValues":{"model":"Bambu Lab X2D 3D Printer"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg"},{"id":"c2b717ac-cf64-4d1a-b1d7-5d64ca66dbd9","sku":"bambu-lab-x2d-3d-printer-Bambu Lab X2D Combo 3D Printer","name":"Bambu Lab X2D Combo 3D Printer","price":"132999","stock":2,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-19T06:55:00.496Z","deletedAt":null,"isDefault":false,"productId":"1531a0af-7645-409a-94c6-d9853ca460a8","salePrice":null,"updatedAt":"2026-07-19T06:55:00.496Z","variantSlug":null,"optionValues":{"model":"Bambu Lab X2D Combo 3D Printer"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg"}],"salePrice":132999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":132999,"description":"<h5 class=\"product-info-name fw-medium\">Bambu Lab X2D 3D Printer<br>\n</h5>\n<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>• Active chamber heating up to 65°C for engineering-grade filaments</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>• AI-powered smart monitoring with dual cameras and real-time failure detection</p>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>• Designed for professional and industrial-grade applications<br></p>\n<div class=\"accordion-title\" data-bs-target=\"#specification\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"specification\" role=\"button\">\n<span>Specifications</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"specification\" class=\"collapse show\">\n<div class=\"accordion-body widget-material\">\n<div class=\"item\">\n<ul>\n<li>\n<b>Print Size (L × W × H) (mm) :</b><span> </span>- 256 × 256 × 260 (Main Nozzle) / 235.5 × 256 × 256 (Dual Nozzle)</li>\n<li>\n<b>Filament Supports :</b><span> </span>- PLA, PETG, ABS, ASA, TPU, PA, PC, PVA, PET, Carbon/Glass Fiber Composites</li>\n<li>\n<b>Supported Nozzle Size :</b><span> </span>- 0.2mm, 0.4mm, 0.6mm, 0.8mm</li>\n<li>\n<b>Hotend Temperature (°C) :</b><span> </span>- 300</li>\n<li>\n<b>Connectivity :</b><span> </span>- Wi-Fi (Dual-Band), USB</li>\n<li>\n<b>Machine Size (mm) :</b><span> </span>- 392 × 406 × 478</li>\n<li>\n<b>Input Voltage (V) :</b><span> </span>- 100–120 / 200–240 AC, 50/60 Hz</li>\n<li>\n<b>Power Supply Requirements :</b><span> </span>- 1000 W (max @ 220V)</li>\n<li>\n<b>No. of Extruders :</b><span> </span>- 2 (Main</li>\n<li>\n<b>Extruder Type :</b><span> </span>- Dual Direct Drive (No Bowden auxiliary)</li>\n<li>\n<b>Chassis :</b><span> </span>- Plastic and Steel</li>\n<li>\n<b>Filament Diameter (mm) :</b><span> </span>- 1.75</li>\n<li>\n<b>Heatbed Temperature (°C) :</b><span> </span>- 120 (max)</li>\n<li>\n<b>Screen Type :</b><span> </span>- 5-inch Touchscreen</li>\n<li>\n<b>Net Weight (kg) :</b><span> </span>- 16.25</li>\n</ul>\n</div>\n</div>\n</div>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><br><br></p>\n<h5 class=\"product-info-name fw-medium\">Bambu Lab X2D Combo 3D Printer</h5>\n<div class=\"product-info-rate\">\n<div class=\"list-star\">\n<i class=\"icon icon-star\"></i><i class=\"icon icon-star\"></i><i class=\"icon icon-star\"></i><i class=\"icon icon-star\"></i><i class=\"icon icon-star\"><span></span></i><br>\n</div>\n</div>\n<h6 class=\"text-main fw-small\">Product Features</h6>\n<p class=\"desc text-sm text-main text-line-clamp-2 text-align-last-end\"><span class=\"text-primary\">•</span><span> </span>The X2D Combo pairs the next-generation X2D printer with the AMS 2 Pro, enabling seamless multi-color and multi-material printing straight out of the box. With active chamber heating, dual-nozzle<br><br></p>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>• 500 mm/s print speed with up to 20,000 mm/s² acceleration for fast, high-quality output</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• Dual-nozzle hybrid toolhead — Direct Drive main + Bowden auxiliary — for clean supports and efficient color switching</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• AMS 2 Pro included — supports up to 16 colors per unit with active filament drying; expandable to 25 colors across multiple units</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• PMSM servo extruder (DynaSense) — 20,000 torque samples per second for real-time clog, tangle, and air-print detection</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• Active chamber heating up to 65°C with adaptive airflow and closed-loop fan control</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• Vision Encoder for 50-micron motion accuracy — precision that holds over thousands of hours</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• AI Dynamic Flow Calibration — builds a real-time, nonlinear model of the full extrusion system for consistent surface quality</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• Dual cameras — 1080p liveview + 1200p toolhead camera — for remote monitoring and AI failure detection</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• Three-layer filtration (G3, H12 HEPA, granulated carbon) removes VOCs and particulates</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>• 5-inch 1280×720 touchscreen with Bambu Studio, Bambu Handy app, and third-party slicer compatibility<br><br>\n<div class=\"accordion-title\" data-bs-target=\"#specification\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"specification\" role=\"button\">\n<span>Specifications</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"specification\" class=\"collapse show\">\n<div class=\"accordion-body widget-material\">\n<div class=\"item\">\n<ul>\n<li>\n<b>Print Size (L × W × H) (mm) :</b><span> </span>- 256 × 256 × 260 (Main Nozzle) / 235.5 × 256 × 256 (Dual Nozzle)</li>\n<li>\n<b>Filament Supports :</b><span> </span>- PLA, PETG, ABS, ASA, TPU, PA, PC, PVA, PET, Carbon/Glass Fiber Composites</li>\n<li>\n<b>Supported Nozzle Size :</b><span> </span>- 0.2mm, 0.4mm, 0.6mm, 0.8mm</li>\n<li>\n<b>Hotend Temperature (°C) :</b><span> </span>- 300</li>\n<li>\n<b>Connectivity :</b><span> </span>- Wi-Fi (Dual-Band), USB</li>\n<li>\n<b>Machine Size (mm) :</b><span> </span>- 392 × 406 × 478</li>\n<li>\n<b>Input Voltage (V) :</b><span> </span>- 100–120 / 200–240 AC, 50/60 Hz</li>\n<li>\n<b>Power Supply Requirements :</b><span> </span>- 1000 W (max @ 220V)</li>\n<li>\n<b>No. of Extruders :</b><span> </span>- 2 (Main</li>\n<li>\n<b>Extruder Type :</b><span> </span>- Dual Direct Drive (No Bowden auxiliary)</li>\n<li>\n<b>Chassis :</b><span> </span>- Plastic and Steel</li>\n<li>\n<b>Filament Diameter (mm) :</b><span> </span>- 1.75</li>\n<li>\n<b>Heatbed Temperature (°C) :</b><span> </span>- 120 (max)</li>\n<li>\n<b>Screen Type :</b><span> </span>- 5-inch Touchscreen</li>\n<li>\n<b>Net Weight (kg) :</b><span> </span>- 18.75</li>\n</ul>\n</div>\n</div>\n</div>\n<br>\n</li>\n</ul>\n</div>\n</div>\n</div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880430-587540589.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880390-740022556.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880392-156103058.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443882091-827027776.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443882176-472010121.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443880398-7607413.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/