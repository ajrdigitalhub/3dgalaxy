rage.app/product-import/1784443910385-221960701.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910380-881755965.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":0,"reviews":[],"variants":[{"id":"17b67599-7980-439f-a76a-8199282c9961","sku":"bambu-lab-ams-lite-Default Title","name":"Default Title","price":"23699","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910391-528780148.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"10000","isActive":true,"createdAt":"2026-07-19T06:56:19.456Z","deletedAt":null,"isDefault":false,"productId":"7a867328-a158-46e5-bc9c-9797963c119b","salePrice":null,"updatedAt":"2026-07-19T06:56:19.456Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910391-528780148.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910391-528780148.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910391-528780148.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910391-528780148.jpg"}],"avgRating":0,"salePrice":23699,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443910391-528780148.jpg","categories":[],"categoryId":null,"isFeatured":false,"weightUnit":"g","categoryIds":[],"category_id":"cfe93849-b68e-4d70-8177-028bf69cdc6a","dealerPrice":23699,"description":"<p>AMS lite brings colors to your 3D printed models, opens up a whole new world for your creativity to soar!With AMS lite, you can setup automatic filament backup to seamlessly load in new spool when the current spool runs out. Ensures an uninterrupted printing process and also preventing filament waste due to manual spool change.The spring loaded rotary spool holder grips the spool at the center hole, improving spool compatibility especially for those paper spools.The simple and exposed design of the AMS lite makes it super easy to work on. Through the translucent shell, user can easily observe the inner operation structure to troubleshoot.With AMS lite, Bambu Lab printers can use snap-away support material or dissolvable filament to minimize the pain of removing supports.</p>\n<p> </p>\n<div class=\"tpl\">\n<h3 class=\"tpl-sectionTitle\">AMS lite Tech Specs</h3>\n<div class=\"tpl-table-content\">\n<div class=\"TableWrapper\">\n<table class=\"tpl-table\">\n<thead>\n<tr>\n<td colspan=\"2\">Item</td>\n<td>AMS lite Specification</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td colspan=\"2\">Product Size</td>\n<td>397*208*342 mm³</td>\n</tr>\n<tr>\n<td colspan=\"2\">Package Size</td>\n<td>470*290*340 mm³</td>\n</tr>\n<tr>\n<td colspan=\"2\">Product Weight</td>\n<td>1.6 kg</td>\n</tr>\n<tr>\n<td colspan=\"2\">Gross Weight</td>\n<td>3.7 kg</td>\n</tr>\n<tr>\n<td colspan=\"2\">Material</td>\n<td>ABS / PC / POM</td>\n</tr>\n<tr>\n<td colspan=\"2\">Supported Filament*¹</td>\n<td>PLA, PETG, ASA, PET, PA, PC, PVA (dry), BVOH (dry), PP, POM, HIPS<br>and Bambu PLA-CF / PAHT-CF</td>\n</tr>\n<tr>\n<td colspan=\"2\">Not Recommended Filament*²</td>\n<td>Bambu PLA Glow, Bambu PETG-CF, and other generic brands of PLA Glow-in-the-dark, etc.</td>\n</tr>\n<tr>\n<td colspan=\"2\">Unsupported Filament*³</td>\n<td>TPE, TPU, PVA (wet), BVOH (wet), Bambu PET-CF / PA6-CF / TPU 95A<br>and other brand filament that contains carbon fiber or glass fiber</td>\n</tr>\n<tr>\n<td colspan=\"2\">Filament Diameter</td>\n<td>1.75 mm</td>\n</tr>\n<tr>\n<td colspan=\"2\">Supported Spool Size</td>\n<td>width: 40 – 68 mm, inner diameter: 53 – 58 mm</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<p> </p>","hasVari