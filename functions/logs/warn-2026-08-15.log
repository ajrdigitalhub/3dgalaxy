":"39999","stock":2,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"10000","isActive":true,"createdAt":"2026-07-19T06:59:56.600Z","deletedAt":null,"isDefault":false,"productId":"fe003f6f-04b0-49f7-a4fb-ab546fb909f9","salePrice":null,"updatedAt":"2026-07-19T06:59:56.600Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg"}],"avgRating":0,"salePrice":39999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","categories":[],"categoryId":null,"isFeatured":false,"weightUnit":"g","categoryIds":[],"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":39999,"description":"<div id=\"shopify-section-template--15390703943728__844e05a9-c7cb-48df-b968-6f429fde58ca\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<h3 class=\"image-with-text--content--inner\"><br></h3>\n<h1 class=\"h3\"><strong>ELEGOO Neptune 4 Max 3D Printer</strong></h1>\n<h4 class=\"image-with-text--content image-with-text--inner\">\n<strong>The Neptune 4 Max comes with the powerful Klipper firmware, enabling impressive printing speeds of up tp 500 mm/s (default 250 mm/s) and up to 12000 mm/s² accelerations, supporting advanced features such as input shaping and pressure adcancing.</strong><br><br><strong>Equipped with acceleration sensors on the X and Y axes for automatic calibration and improved print quality.</strong>\n</h4>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--large\"><img class=\"lazyautosizes lazyloaded\" width=\"538\" height=\"555\" data-sizes=\"auto\" src=\"https://www.elegoo.com/cdn/shop/files/N4M-7_20x20_crop_center.jpg?v=1703056804\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4M-7_690x711_crop_center.jpg?v=1703056804 690w,//www.elegoo.com/cdn/shop/files/N4M-7_1280x1320_crop_center.jpg?v=1703056804 1280w,//www.elegoo.com/cdn/shop/files/N4M-7_630x650_crop_center.jpg?v=1703056804 630w\" alt=\"\" sizes=\"498px\" srcset=\"//www.elegoo.com/cdn/shop/files/N4M-7_690x711_crop_center.jpg?v=1703056804 690w,//www.elegoo.com/cdn/shop/files/N4M-7_1280x1320_crop_center.jpg?v=1703056804 1280w,//www.elegoo.com/cdn/shop/files/N4M-7_630x650_crop_center.jpg?v=1703056804 630w\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4M-7_20x20_crop_center.jpg?v=1703056804\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--15390703943728__e8ea6cdf-141d-4677-b629-fdd69ddb0a3e\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h4 class=\"h3\">\n<span style=\"font-size: 0.875rem;\" data-mce-style=\"font-size: 0.875rem;\">Neptune 4 Max adopts a Klipper motherboard and ARM 64-bit 1.5G main frequency quad-core processor.</span><br>\n</h4>\n<div class=\"rte\">\n<h4>\n<strong>With pre-installed Klipper firmware, the printing speed can reach 500mm/s (default 250mm/s) with up to 12000mm/s acceleration. 8G RAM gives you ample storage capacity for various print files.</strong><br><br><strong>In addition, the printer supports input shaping and pressure advance to improve print quality and reduce issues like artifacts, filament ooze, and blobbing. With acceleration sensors on the X-axis and Y-axis to automatically calibrate resonance compensation parameters for less vibrations and precise prints.</strong>\n</h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--large\"><img class=\"lazyautosizes lazyloaded\" width=\"541\" height=\"558\" data-sizes=\"auto\" src=\"https://www.elegoo.com/cdn/shop/files/N4PL-8_20x20_crop_center.jpg?v=1703050527\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4PL-8_690x711_crop_center.jpg?v=1703050527 690w,//www.elegoo.com/cdn/shop/files/N4PL-8_1280x1320_crop_center.jpg?v=1703050527 1280w,//www.elegoo.com/cdn/shop/files/N4PL-8_630x650_crop_center.jpg?v=1703050527 630w\" alt=\"\" sizes=\"498px\" srcset=\"//www.elegoo.com/cdn/shop/files/N4PL-8_690x711_crop_center.jpg?v=1703050527 690w,//www.elegoo.com/cdn/shop/files/N4PL-8_1280x1320_crop_center.jpg?v=1703050527 1280w,//www.elegoo.com/cdn/shop/files/N4PL-8_630x650_crop_center.jpg?v=1703050527 630w\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4PL-8_20x20_crop_center.jpg?v=1703050527\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--15390703943728__00f04487-4746-43db-ba40-17f2c42dc0f0\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<div class=\"rte\">\n<h4>With a spacious build volume of 420 x 420 x 480 mm³, our printer allows you to bring your ambitious designs to life, whether for large models or multiple smaller objects, this generous build volume provides ample space for your creations.</h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"lazyautosizes lazyloaded\" width=\"543\" height=\"559\" data-sizes=\"auto\" src=\"https://www.elegoo.com/cdn/shop/files/N4M-9_20x20_crop_center.jpg?v=1703056326\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4M-9_690x711_crop_center.jpg?v=1703056326 690w,//www.elegoo.com/cdn/shop/files/N4M-9_1280x1320_crop_center.jpg?v=1703056326 1280w,//www.elegoo.com/cdn/shop/files/N4M-9_630x650_crop_center.jpg?v=1703056326 630w\" alt=\"\" sizes=\"498px\" srcset=\"//www.elegoo.com/cdn/shop/files/N4M-9_690x711_crop_center.jpg?v=1703056326 690w,//www.elegoo.com/cdn/shop/files/N4M-9_1280x1320_crop_center.jpg?v=1703056326 1280w,//www.elegoo.com/cdn/shop/files/N4M-9_630x650_crop_center.jpg?v=1703056326 630w\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4M-9_20x20_crop_center.jpg?v=1703056326\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--15390703943728__3c4bd311-db2b-4923-93f4-a04818af9104\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<div class=\"rte\">\n<h4><strong>The 300°C high-temp nozzle kit features an extended hot end, a 60W ceramic heating element and a brass heating block, capable of printing various filaments including nylon.</strong></h4>\n<h4><strong>The automatic calibration of nozzle PID parameters ensures precise temperature control for stable and consistent printing performance.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"lazyautosizes lazyloaded\" width=\"548\" height=\"565\" data-sizes=\"auto\" src=\"https://www.elegoo.com/cdn/shop/files/N4M-10_20x20_crop_center.jpg?v=1703056326\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4M-10_690x711_crop_center.jpg?v=1703056326 690w,//www.elegoo.com/cdn/shop/files/N4M-10_1280x1320_crop_center.jpg?v=1703056326 1280w,//www.elegoo.com/cdn/shop/files/N4M-10_630x650_crop_center.jpg?v=1703056326 630w\" alt=\"\" sizes=\"498px\" srcset=\"//www.elegoo.com/cdn/shop/files/N4M-10_690x711_crop_center.jpg?v=1703056326 690w,//www.elegoo.com/cdn/shop/files/N4M-10_1280x1320_crop_center.jpg?v=1703056326 1280w,//www.elegoo.com/cdn/shop/files/N4M-10_630x650_crop_center.jpg?v=1703056326 630w\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4M-10_20x20_crop_center.jpg?v=1703056326\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--15390703943728__5ccae3ab-f964-4db6-932f-ccc4dcd9cd44\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<div class=\"rte\">\n<h4><strong>The dual-gear direct extruder with a 5.2:1 reduction ratio for reliable and smooth filament extrusion, weighing only 290g. All-titanium alloy throat pipe enables fast heat dissipation and reduces nozzle clogging. 60W high-power ceramic heating element and brass heating block provide efficient and uniform heating for quick filament melting even during high-speed printing.</strong></h4>\n<h4>\n<strong>The extended hotend nozzle can withstand temperatures up to 300°C, making it capable of printing PLA, PETG, ABS, TPU, and high-temp filament nylon.</strong><br>\n</h4>\n<h4><strong>The automatic calibration of nozzle PID parameters optimizes nozzle thermal performance and temperature control, ensuring consistent and reliable printing results.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h3 class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"lazyautosizes lazyloaded\" width=\"550\" height=\"567\" data-sizes=\"auto\" src=\"https://www.elegoo.com/cdn/shop/files/N4M-11_20x20_crop_center.jpg?v=1703056326\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4M-11_690x711_crop_center.jpg?v=1703056326 690w,//www.elegoo.com/cdn/shop/files/N4M-11_1280x1320_crop_center.jpg?v=1703056326 1280w,//www.elegoo.com/cdn/shop/files/N4M-11_630x650_crop_center.jpg?v=1703056326 630w\" alt=\"\" sizes=\"498px\" srcset=\"//www.elegoo.com/cdn/shop/files/N4M-11_690x711_crop_center.jpg?v=1703056326 690w,//www.elegoo.com/cdn/shop/files/N4M-11_1280x1320_crop_center.jpg?v=1703056326 1280w,//www.elegoo.com/cdn/shop/files/N4M-11_630x650_crop_center.jpg?v=1703056326 630w\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4M-11_20x20_crop_center.jpg?v=1703056326\"></h3>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div id=\"shopify-section-template--15390703943728__01e5aef7-91b9-4e05-b430-c86652a9aff5\" class=\"shopify-section section-image-with-text\">\n<div id=\"\" class=\"row\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<div class=\"rte\">\n<h4><strong>Connect seamlessly with our printer using various options including WIFI, U disk, and LAN connectivity.</strong></h4>\n<h4><strong>Enjoy the convenience of WEB remote control printing and multi-machine network printing control for effortless management of your printing projects.</strong></h4>\n<h4><strong>Just start your printing jobs with a one-key file transfer.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h3 class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img class=\"lazyautosizes lazyloaded\" width=\"549\" height=\"566\" data-sizes=\"auto\" src=\"https://www.elegoo.com/cdn/shop/files/N4M-wifi_1_20x20_crop_center.jpg?v=1703130204\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4M-wifi_1_690x711_crop_center.jpg?v=1703130204 690w,//www.elegoo.com/cdn/shop/files/N4M-wifi_1_1280x1320_crop_center.jpg?v=1703130204 1280w,//www.elegoo.com/cdn/shop/files/N4M-wifi_1_630x650_crop_center.jpg?v=1703130204 630w\" alt=\"\" sizes=\"498px\" srcset=\"//www.elegoo.com/cdn/shop/files/N4M-wifi_1_690x711_crop_center.jpg?v=1703130204 690w,//www.elegoo.com/cdn/shop/files/N4M-wifi_1_1280x1320_crop_center.jpg?v=1703130204 1280w,//www.elegoo.com/cdn/shop/files/N4M-wifi_1_630x650_crop_center.jpg?v=1703130204 630w\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4M-wifi_1_20x20_crop_center.jpg?v=1703130204\"></h3>\n</div>\n</div>\n</div>\n</div>\n</div>","hasVariants":true,"isExclusive":false,"ratingCount":0,"reviewCount":0,"codAvailable":true,"latestReview":null,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","totalReviews":0,"averageRating":0,"galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025365-385107070.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025337-704184821.jpg","https