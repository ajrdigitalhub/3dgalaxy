-871253653.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"20000","isActive":true,"createdAt":"2026-07-19T06:58:40.283Z","deletedAt":null,"isDefault":false,"productId":"ea68196d-460f-463c-bcd9-9f61310a80b8","salePrice":"69999","updatedAt":"2026-07-19T06:58:40.283Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg"}],"salePrice":69999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":69999,"description":"<p><span>Experience effortless 3D printing with the Bambu Lab P1S. This printer sets up in just 15 minutes, boasting a well-polished design and software for seamless operation. Its enclosed body supports high-temperature filament printing, while the AMS enables up to 16-color printing. With up to 20,000 mm/s² acceleration, enjoy rapid printing without compromising quality. Plus, monitor your prints remotely with the built-in camera and Bambu Studio integration </span></p>\n<p><span><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/Group_47489_76f7309f-4767-4dac-8a0d-24996ee9f3dc.png?v=1739388901\" alt=\"\"></span></p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/P1S-Multi-color.png?v=1740340302\" alt=\"\"></p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/2_7915f07e-1841-4389-8038-455c3cb52fe8.jpg?v=1740340330\" alt=\"\"></p>\n<p><br></p>\n<p><span><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/P1S-feature-mob-1.png?v=1739389000\" alt=\"\"></span></p>\n<h4>Features:</h4>\n<ol>\n<li>Works right out of the box, set up in 15 minutes.</li>\n<li>Well-polished hardware and software.</li>\n<li>Enclosed body for high-temperature filament printing.</li>\n<li>Up to 16-color printing with AMS.</li>\n<li>Up to 20000 mm/s² acceleration, prints a benchy in 18min.</li>\n<li>Build-in camera for remote monitoring and timelapse.</li>\n<li>Hot End: All-Metal.</li>\n<li>Nozzle: Stainless Steel.</li>\n<li>Max Hot End Temperature: 300.</li>\n<li>Build Plate Surface Compatibility: Bambu Textured PEI Plate, Bambu Cool Plate, Bambu Engineering Plate, Bambu High-Temperature Plate</li>\n<li>Max Build Plate Temperature: 100.</li>\n<li>Max Speed of Tool Head: 500 mm/s.</li>\n<li>Max Acceleration of Tool Head: 20 m/s².</li>\n<li>Filament Run Out Sensor: Yes</li>\n<li>Electrical Requirements: 100-240 VAC, 50/60 Hz, 1000 W @220 V, 350W@110V.</li>\n</ol>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988916-800230610.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988854-397205766.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988884-298445697.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443991103-929814997.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988916-800230610.jpg","shortDescription":"<p><span>Experience effortless 3D printing with the Bambu Lab P1S. This printer sets up in just 15 minutes, boasting a well-polished design and software for seamless operation. Its enclosed body supports high-temperature filament printing, while the AMS enables up to 16-color printing. With up to 20,000 mm/s² acceleration, enjoy rapid printing without compromising quality. Plus, monitor your prints remotely with the built-in camera and Bambu Studio integration </span></p>\n<p><span><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/Group_47489_76f7309f-4767-4dac-8a0d-24996ee9f3dc.png?v=1739388901\" alt=\"\"></span></p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/P1S-Multi-color.png?v=1740340302\" alt=\"\"></p>\n<p><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/2_7915f07e-1841-4389-8038-455c3cb52fe8.jpg?v=1740340330\" alt=\"\"></p>\n<p><br></p>\n<p><span><img src=\"https://cdn.shopify.com/s/files/1/0848/9943/0675/files/P1S-feature-mob-1.png?v=1739389000\" alt=\"\"></span></p>\n<h4>Features:</h4>\n<ol>\n<li>Works right out of the box, set up in 15 minutes.</li>\n<li>Well-polished hardware and software.</li>\n<li>Enclosed body for high-temperature filament printing.</li>\n<li>Up to 16-color printing with AMS.</li>\n<li>Up to 20000 mm/s² acceleration, prints a benchy in 18min.</li>\n<li>Build-in camera for remote monitoring and timelapse.</li>\n<li>Hot End: All-Metal.</li>\n<li>Nozzle: Stainless Steel.</li>\n<li>Max Hot End Temperature: 300.</li>\n<li>Build Plate Surface Compatibility: Bambu Textured PEI Plate, Bambu Cool Plate, Bambu Engineering Plate, Bambu High-Temperature Plate</li>\n<li>Max Build Plate Temperature: 100.</li>\n<li>Max Speed of Tool Head: 500 mm/s.</li>\n<li>Max Acceleration of Tool Head: 20 m/s².</li>\n<li>Filament Run Out Sensor: Yes</li>\n<li>Electrical Requirements: 100-240 VAC, 50/60 Hz, 1000 W @220 V, 350W@110V.</li>\n</ol>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443988844-871253653.jpg"]},{"id":"097c0f69-5c43-4f0c-a5e1-7abccef4ead2","mrp":3500,"sku":"hotend-kit-for-neptune-4-max","name":"Hotend Kit for Neptune 4 Max / 4 Plus","slug":"hotend-kit-for-neptune-4-max","brand":"e8665147-633e-4b6d-b462-cbfdc6114665","stock":23,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006924-700502633.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"70fb4e10-cec3-4d0a-ae2a-d89ab21ecb41","sku":"hotend-kit-for-neptune-4-max-0.4 MM","name":"0.4 MM","price":"3500","stock":23,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"200","isActive":true,"createdAt":"2026-07-19T06:59:15.070Z","deletedAt":null,"isDefault":false,"productId":"097c0f69-5c43-4f0c-a5e1-7abccef4ead2","salePrice":"1499","updatedAt":"2026-07-19T06:59:15.070Z","variantSlug":null,"optionValues":{"SIZE":"0.4 MM"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png"}],"salePrice":1499,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","isFeatured":false,"category_id":"55a711ea-3f62-443b-9b00-dc8d361e5cac","dealerPrice":1499,"description":"<h2 class=\"productView-title\">Description</h2>\n<div data-content-region=\"product_below_description_title\"><br></div>\n<div data-content-region=\"product_below_description_title--global\"><br></div>\n<div>\n<p><strong>High-Performance Assembled Extruder Hotend Kit for Neptune 4 Plus / 4 Max </strong>:<span> </span><strong>Boost Your 3D Printing Precision and Versatility with Reliable Performance</strong></p>\n<p>This Assembled Extruder Hotend Kit for Neptune 4 and Neptune 4 Pro 3D printers is designed for precision and reliability, making it an essential addition for both professionals and hobbyists. With a robust combination of components—including a 0.4mm brass nozzle, PTFE tube, copper-titanium throat pipe, and an advanced aluminum heating block—this comprehensive kit ensures smooth, high-temperature printing up to 300℃. Its effective heat dissipation and seamless connection design provide stability during printing, allowing for consistent, high-quality output across a wide range of filament types, including PLA, ABS, PETG, TPU, and even high-temperature materials like nylon.</p>\n<p>Built for effortless installation, this extruder hotend kit integrates seamlessly with your Neptune 4 Plus or Neptune 4 Max, thanks to its modular interface and easy assembly. Upgrade your printing capabilities and open doors to more creative projects with enhanced accuracy and versatility.</p>\n<div><strong>Features:</strong></div>\n<ul>\n<li>\n<div>\n<strong>Comprehensive Kit</strong>: Includes essential components like a 0.4mm brass nozzle, PTFE tube, copper-titanium throat pipe, and aluminum heating block.</div>\n</li>\n<li>\n<div>\n<strong>Efficient Heat Dissipation</strong>: Features an advanced, widened aluminum heat silk that effectively dissipates heat, preventing overheating and ensuring consistent results.</div>\n</li>\n<li>\n<div>\n<strong>Precise Temperature Control</strong>: Allows high-temperature printing up to 300℃, enabling compatibility with a variety of filaments.</div>\n</li>\n<li>\n<div>\n<strong>Seamless Connection</strong>: Designed for a secure, leak-free fit that prevents filament oozing, providing a smoother printing experience.</div>\n</li>\n<li>\n<div>\n<strong>Easy Installation</strong>: Quick and straightforward setup with screws and a modular interface, designed specifically for Neptune 4 Plus and Neptune 4 Max.</div>\n</li>\n<li>\n<div>\n<strong>Wide Compatibility</strong>: Suitable for PLA, ABS, PETG, TPU, and high-temperature filaments like nylon, expanding your creative possibilities.</div>\n</li>\n</ul>\n</div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006924-700502633.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006924-700502633.jpg","shortDescription":"<h2 class=\"productView-title\">Description</h2>\n<div data-content-region=\"product_below_description_title\"><br></div>\n<div data-content-region=\"product_below_description_title--global\"><br></div>\n<div>\n<p><strong>High-Performance Assembled Extruder Hotend Kit for Neptune 4 Plus / 4 Max </strong>:<span> </span><strong>Boost Your 3D Printing Precision and Versatility with Reliable Performance</strong></p>\n<p>This Assembled Extruder Hotend Kit for Neptune 4 and Neptune 4 Pro 3D printers is designed for precision and reliability, making it an essential addition for both professionals and hobbyists. With a robust combination of components—including a 0.4mm brass nozzle, PTFE tube, copper-titanium throat pipe, and an advanced aluminum heating block—this comprehensive kit ensures smooth, high-temperature printing up to 300℃. Its effective heat dissipation and seamless connection design provide stability during printing, allowing for consistent, high-quality output across a wide range of filament types, including PLA, ABS, PETG, TPU, and even high-temperature materials like nylon.</p>\n<p>Built for effortless installation, this extruder hotend kit integrates seamlessly with your Neptune 4 Plus or Neptune 4 Max, thanks to its modular interface and easy assembly. Upgrade your printing capabilities and open doors to more creative projects with enhanced accuracy and versatility.</p>\n<div><strong>Features:</strong></div>\n<ul>\n<li>\n<div>\n<strong>Comprehensive Kit</strong>: Includes essential components like a 0.4mm brass nozzle, PTFE tube, copper-titanium throat pipe, and aluminum heating block.</div>\n</li>\n<li>\n<div>\n<strong>Efficient Heat Dissipation</strong>: Features an advanced, widened aluminum heat silk that effectively dissipates heat, preventing overheating and ensuring consistent results.</div>\n</li>\n<li>\n<div>\n<strong>Precise Temperature Control</strong>: Allows high-temperature printing up to 300℃, enabling compatibility with a variety of filaments.</div>\n</li>\n<li>\n<div>\n<strong>Seamless Connection</strong>: Designed for a secure, leak-free fit that prevents filament oozing, providing a smoother printing experience.</div>\n</li>\n<li>\n<div>\n<strong>Easy Installation</strong>: Quick and straightforward setup with screws and a modular interface, designed specifically for Neptune 4 Plus and Neptune 4 Max.</div>\n</li>\n<li>\n<div>\n<strong>Wide Compatibility</strong>: Suitable for PLA, ABS, PETG, TPU, and high-temperature filaments like nylon, expanding your creative possibilities.</div>\n</li>\n</ul>\n</div>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444006946-452622805.png"]},{"id":"cce3d328-810b-4f01-ab23-a1bd93cd15a5","mrp":30499,"sku":"ender-3-v3-ke","name":"ENDER 3 V3 KE","slug":"ender-3-v3-ke","brand":"e8665147-633e-4b6d-b462-cbfdc6114665","stock":10,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013684-319830725.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013700-290650285.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013752-744688304.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013756-646182380.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015398-895229034.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015466-264515777.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015472-313692923.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444015842-244004732.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"bfd666b8-a36f-4477-b25b-cf2402df07d4","sku":"ender-3-v3-ke-Default Title","name":"Default Title","price":"30499","stock":10,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444013684-319830725.jpg","isPrimary":false,"sortOrder":0,