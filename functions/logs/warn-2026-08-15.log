ues":{"Colour":"black"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443951454-482655673.png","galleryImages":[],"variantImages":[],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443951454-482655673.png"}],"avgRating":0,"salePrice":1200,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443951454-482655673.png","categories":[],"categoryId":null,"isFeatured":false,"weightUnit":"g","categoryIds":[],"category_id":"63697a14-571f-4374-9409-8b31254112a7","dealerPrice":1200,"description":"<p data-start=\"71\" data-end=\"455\"><strong data-start=\"71\" data-end=\"95\">Product Description:</strong><br data-start=\"95\" data-end=\"98\">High-quality <strong data-start=\"111\" data-end=\"152\">3D Galaxy UV Sensitive Standard Resin</strong> (1kg) designed for precision 3D printing. This resin delivers excellent detail, smooth surface finish, and reliable curing under UV light. Perfect for creating functional prototypes, models, and detailed prints with strong adhesion and minimal shrinkage. Compatible with most LCD/DLP/SLA 3D printers.</p>\n<p data-start=\"457\" data-end=\"476\"><strong data-start=\"457\" data-end=\"474\">Key Features:</strong></p>\n<p data-start=\"479\" data-end=\"496\">Weight: <strong data-start=\"487\" data-end=\"494\">1kg</strong></p>\n<p data-start=\"499\" data-end=\"542\">Material: <strong data-start=\"509\" data-end=\"540\">Standard UV Sensitive Resin</strong></p>\n<p data-start=\"545\" data-end=\"562\">Color: <strong data-start=\"552\" data-end=\"560\">Skin,Black,Grey,white,Clear</strong></p>\n<p data-start=\"565\" data-end=\"597\">High precision &amp; smooth finish</p>\n<p data-start=\"600\" data-end=\"636\">Strong layer adhesion &amp; durability</p>\n<p data-start=\"639\" data-end=\"668\">Low shrinkage &amp; deformation</p>\n<p data-start=\"671\" data-end=\"693\">Easy post-processing</p>\n<p data-start=\"695\" data-end=\"809\"><strong data-start=\"695\" data-end=\"712\">Applications:</strong><br data-start=\"712\" data-end=\"715\">Ideal for <strong data-start=\"725\" data-end=\"806\">prototypes, figurines, dental models, engineering parts, and artistic designs</strong>.</p>\n<p data-start=\"811\" data-end=\"834\"><strong data-start=\"811\" data-end=\"832\">Storage &amp; Safety:</strong></p>\n<p data-start=\"837\" data-end=\"885\">Store in a cool, dry place away from sunlight.</p>\n<p data-start=\"888\" data-end=\"912\">Shake well before use.</p>\n<p data-start=\"915\" data-end=\"951\">Wear gloves &amp; mask while handling.</p>\n<p data-start=\"954\" data-end=\"1006\">Wash prints with isopropyl alcohol after printing.</p>","hasVariants":true,"isExclusive":false,"ratingCount":0,"reviewCount":0,"codAvailable":true,"latestReview":null,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443951454-482655673.png","totalReviews":0,"averageRating":0,"galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443951454-482655673.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443955809-805625772.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443958188-28081959.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443957445-851809965.png"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443951454-482655673.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443955809-805625772.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443958188-28081959.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443957445-851809965.png"],"weightInGrams":0,"isCodAvailable":true,"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.