3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg"}],"salePrice":28000,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":28000,"description":"<div data-cel-widget=\"title_feature_div\" data-csa-c-id=\"seumv8-ht1gij-a3aneu-hofakq\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"B0C749177C\" data-csa-c-slot-id=\"title_feature_div\" data-csa-c-content-id=\"title\" data-csa-c-type=\"widget\" data-feature-name=\"title\" class=\"celwidget\" id=\"title_feature_div\">\n<h1 class=\"a-section a-spacing-none\" id=\"titleSection\"><strong>ELEGOO Neptune 4 Pro FDM 3D Printer</strong></h1>\n<span data-resolver=\"CQResolver\" data-position=\"1\" data-edit-data-state=\"productTitleEDPEditData\" data-display-name=\"Product Name\" data-custom-event-handler=\"productTitleEDPCustomEventHandler\" data-feature-container-id=\"productTitle\" data-metadata=\"CATALOG\" data-defects='[{\"id\":\"defect-mismatch-info\",\"value\":\"Different from product\"},{\"id\":\"defect-missing-information\",\"value\":\"Missing information\"},{\"id\":\"defect-unessential-info\",\"value\":\"Unimportant information\"},{\"id\":\"defect-incorrect-information\",\"value\":\"Incorrect information\"},{\"id\":\"defect-other-productinfo-issue\",\"value\":\"Other\"}]' data-data-hash=\"4005622554\" data-edp-asin=\"B0C749177C\" data-edp-feature-name=\"title\" class=\"edp-feature-declaration\"></span>\n</div>\n<div data-cel-widget=\"qpeTitleTag_feature_div\" data-csa-c-id=\"gcra6b-1issn4-vnel0c-m6qfqz\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"B0C749177C\" data-csa-c-slot-id=\"qpeTitleTag_feature_div\" data-csa-c-content-id=\"qpeTitleTag\" data-csa-c-type=\"widget\" data-feature-name=\"qpeTitleTag\" class=\"celwidget\" id=\"qpeTitleTag_feature_div\"><br></div>\n<div data-cel-widget=\"bylineInfo_feature_div\" data-csa-c-id=\"c0xwdp-vxqvo0-v852kx-vfifon\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"B0C749177C\" data-csa-c-slot-id=\"bylineInfo_feature_div\" data-csa-c-content-id=\"bylineInfo\" data-csa-c-type=\"widget\" data-feature-name=\"bylineInfo\" class=\"celwidget\" id=\"bylineInfo_feature_div\">\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__844e05a9-c7cb-48df-b968-6f429fde58ca\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\"><strong><span class=\"animated-marker\">Speed Up<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span> Printing with Klipper</strong></h2>\n<div class=\"rte\">\n<h4>With the Klipper motherboard and ARM 64-bit 1.5G main frequency quad-core processor to process and execute commands faster, Neptune 4 Pro can print at up to 500mm/s, allowing you to complete your print projects quickly and efficiently. With our pre-installed Klipper firmware, you can start printing right away without the hassle of firmware installation.</h4>\n<h4><strong>In addition, it supports input shaping, which helps eliminate artifacts and resonances on the model surface, and pressure advance, which helps predict nozzle pressure for more accurate and consistent extrusion and less filament ooze and blobbing.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--large\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"559\" width=\"542\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_20x20_crop_center.jpg?v=1703041792\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__e8ea6cdf-141d-4677-b629-fdd69ddb0a3e\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\">\n<span class=\"animated-marker\">Potent<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Extrusion &amp; Upgraded Hotend</h2>\n<div class=\"rte\">\n<h4>The printer's dual-gear direct drive extruder is another key feature that ensures smooth and consistent extrusion, weighing only 75% of the weight of the Neptune 3 Pro.</h4>\n<h4>The 5.2:1 reduction ratio and dual-gear design ensure a firm grip on the filament and prevent the flexible filament from slipping and grinding. The copper-titanium bi-metal throat pipe has a unique air duct design for faster heat dissipation of the throat pipe and less nozzle clogging.</h4>\n<h4>The 300°C high-temp nozzle with an extended hotend design to fully melt the filament, and you can explore a wider range of materials, such as PLA, PETG, ABS, TPU, and high-temp filaments like nylon.</h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--large\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"562\" width=\"545\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_20x20_crop_center.jpg?v=1703041792\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__00f04487-4746-43db-ba40-17f2c42dc0f0\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<h2 class=\"image-with-text--content--inner\">\n<span class=\"animated-marker\">Unparalleled<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Heat Dissipation Performance</h2>\n<div class=\"rte\"><strong>In addition to the two thickened 4015 ball bearing cooling fan on both sides of the print head, there are four 4020 ball bearing auxiliary fans behind the print head, which ensures omnidirectional rapid cooling of the newly printed layers even at a fast printing speed, and the deposited hot filament quickly bond together for better overhang and bridge results.</strong></div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"561\" width=\"544\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_20x20_crop_center.jpg?v=1703041792\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__3c4bd311-db2b-4923-93f4-a04818af9104\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<h2 class=\"image-with-text--content--inner\">\n<span class=\"animated-marker\">Stable &amp; Quiet<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Printing</h2>\n<div class=\"rte\">\n<h4>The ELEGOO Neptune 4 Pro 3D printer is designed for quiet and precise printing with its silent drivers for all axes, reducing noise to below 50db. Its wear-resistant POM V-guide wheels moves quietly, smoothly, and accurately.</h4>\n<h4>The Z-axis dual lead screw + Z-axis dual motor design provides better synchronization, increasing the accuracy and stability of the print head movement.</h4>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_690x711_crop_center.jpg?v=1703041791 690w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_1280x1320_crop_center.jpg?v=1703041791 1280w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_630x650_crop_center.jpg?v=1703041791 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_690x711_crop_center.jpg?v=1703041791 690w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_1280x1320_crop_center.jpg?v=1703041791 1280w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_630x650_crop_center.jpg?v=1703041791 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_20x20_crop_center.jpg?v=1703041791\" data-sizes=\"auto\" height=\"566\" width=\"548\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_20x20_crop_center.jpg?v=1703041791\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__5ccae3ab-f964-4db6-932f-ccc4dcd9cd44\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\">\n<span class=\"animated-marker\">Smoother<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Model Surface</h2>\n<div class=\"rte\">\n<h4>Support advanced functions like input shaping and pressure advance to achieve smooth model surface and consistent extrusion</h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"564\" width=\"546\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_20x20_crop_center.jpg?v=1703041792\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__cf46d79a-4564-4888-be93-58ccb5ce597c\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\">Intelligent<span> </span><span class=\"animated-marker\">Segmented<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Heatbed</h2>\n<div class=\"rte\">\n<h4><strong>With 100W+150W power output, the slicing software automatically recognizes the size of the model during slicing and activates the peripheral heating zone if the model size exceeds the center heating zone (120mmx120mm).</strong></h4>\n<h4><strong>The two partitions can also be turned on and off manually for more precise temperature control.</strong></h4>\n<h4><strong>Additionally, the surface of the PEI magnetic platform is marked for guidance.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"558\" width=\"541\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_20x20_crop_center.jpg?v=1703041792\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024412-319629923.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024373-884655386.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024371-577925806.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444027038-269070601.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444026317-567777085.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444027129-816206219.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024412-319629923.jpg","shortDescription":"<div data-cel-widget=\"title_feature_div\" data-csa-c-id=\"seumv8-ht1gij-a3aneu-hofakq\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"B0C749177C\" data-csa-c-slot-id=\"title_feature_div\" data-csa-c-content-id=\"title\" data-csa-c-type=\"widget\" data-feature-name=\"title\" class=\"celwidget\" id=\"title_feature_div\">\n<h1 class=\"a-section a-spacing-none\" id=\"titleSection\"><strong>ELEGOO Neptune 4 Pro FDM 3D Printer</strong></h1>\n<span data-resolver=\"CQResolver\" data-position=\"1\" data-edit-data-state=\"productTitleEDPEditData\" data-display-name=\"Product Name\" data-custom-event-handler=\"productTitleEDPCustomEventHandler\" data-feature-container-id=\"productTitle\" data-metadata=\"CATALOG\" data-defects='[{\"id\":\"defect-mismatch-info\",\"value\":\"Different from product\"},{\"id\":\"defect-missing-information\",\"value\":\"Missing information\"},{\"id\":\"defect-unessential-info\",\"value\":\"Unimportant information\"},{\"id\":\"defect-incorrect-information\",\"value\":\"Incorrect information\"},{\"id\":\"defect-other-productinfo-issue\",\"value\":\"Other\"}]' data-data-hash=\"4005622554\" data-edp-asin=\"B0C749177C\" data-edp-feature-name=\"title\" class=\"edp-feature-declaration\"></span>\n</div>\n<div data-cel-widget=\"qpeTitleTag_feature_div\" data-csa-c-id=\"gcra6b-1issn4-vnel0c-m6qfqz\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"B0C749177C\" data-csa-c-slot-id=\"qpeTitleTag_feature_div\" data-csa-c-content-id=\"qpeTitleTag\" data-csa-c-type=\"widget\" data-feature-name=\"qpeTitleTag\" class=\"celwidget\" id=\"qpeTitleTag_feature_div\"><br></div>\n<div data-cel-widget=\"bylineInfo_feature_div\" data-csa-c-id=\"c0xwdp-vxqvo0-v852kx-vfifon\" data-csa-c-is-in-initial-active-row=\"false\" data-csa-c-asin=\"B0C749177C\" data-csa-c-slot-id=\"bylineInfo_feature_div\" data-csa-c-content-id=\"bylineInfo\" data-csa-c-type=\"widget\" data-feature-name=\"bylineInfo\" class=\"celwidget\" id=\"bylineInfo_feature_div\">\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__844e05a9-c7cb-48df-b968-6f429fde58ca\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\"><strong><span class=\"animated-marker\">Speed Up<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span> Printing with Klipper</strong></h2>\n<div class=\"rte\">\n<h4>With the Klipper motherboard and ARM 64-bit 1.5G main frequency quad-core processor to process and execute commands faster, Neptune 4 Pro can print at up to 500mm/s, allowing you to complete your print projects quickly and efficiently. With our pre-installed Klipper firmware, you can start printing right away without the hassle of firmware installation.</h4>\n<h4><strong>In addition, it supports input shaping, which helps eliminate artifacts and resonances on the model surface, and pressure advance, which helps predict nozzle pressure for more accurate and consistent extrusion and less filament ooze and blobbing.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--large\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"559\" width=\"542\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-7-Speed_Up_Printing_with_Klipper_20x20_crop_center.jpg?v=1703041792\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__e8ea6cdf-141d-4677-b629-fdd69ddb0a3e\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\">\n<span class=\"animated-marker\">Potent<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Extrusion &amp; Upgraded Hotend</h2>\n<div class=\"rte\">\n<h4>The printer's dual-gear direct drive extruder is another key feature that ensures smooth and consistent extrusion, weighing only 75% of the weight of the Neptune 3 Pro.</h4>\n<h4>The 5.2:1 reduction ratio and dual-gear design ensure a firm grip on the filament and prevent the flexible filament from slipping and grinding. The copper-titanium bi-metal throat pipe has a unique air duct design for faster heat dissipation of the throat pipe and less nozzle clogging.</h4>\n<h4>The 300°C high-temp nozzle with an extended hotend design to fully melt the filament, and you can explore a wider range of materials, such as PLA, PETG, ABS, TPU, and high-temp filaments like nylon.</h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--large\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"562\" width=\"545\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-8-Potent_Extrusion_Upgrade_Hotend_20x20_crop_center.jpg?v=1703041792\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__00f04487-4746-43db-ba40-17f2c42dc0f0\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<h2 class=\"image-with-text--content--inner\">\n<span class=\"animated-marker\">Unparalleled<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Heat Dissipation Performance</h2>\n<div class=\"rte\"><strong>In addition to the two thickened 4015 ball bearing cooling fan on both sides of the print head, there are four 4020 ball bearing auxiliary fans behind the print head, which ensures omnidirectional rapid cooling of the newly printed layers even at a fast printing speed, and the deposited hot filament quickly bond together for better overhang and bridge results.</strong></div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"561\" width=\"544\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-9-Unparalleled_Heat_Dissipation_Performance_20x20_crop_center.jpg?v=1703041792\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__3c4bd311-db2b-4923-93f4-a04818af9104\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing section-spacing--disable-bottom\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<h2 class=\"image-with-text--content--inner\">\n<span class=\"animated-marker\">Stable &amp; Quiet<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Printing</h2>\n<div class=\"rte\">\n<h4>The ELEGOO Neptune 4 Pro 3D printer is designed for quiet and precise printing with its silent drivers for all axes, reducing noise to below 50db. Its wear-resistant POM V-guide wheels moves quietly, smoothly, and accurately.</h4>\n<h4>The Z-axis dual lead screw + Z-axis dual motor design provides better synchronization, increasing the accuracy and stability of the print head movement.</h4>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_690x711_crop_center.jpg?v=1703041791 690w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_1280x1320_crop_center.jpg?v=1703041791 1280w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_630x650_crop_center.jpg?v=1703041791 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_690x711_crop_center.jpg?v=1703041791 690w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_1280x1320_crop_center.jpg?v=1703041791 1280w,//www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_630x650_crop_center.jpg?v=1703041791 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_20x20_crop_center.jpg?v=1703041791\" data-sizes=\"auto\" height=\"566\" width=\"548\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-10-Stable_and_Quiet_Printing_20x20_crop_center.jpg?v=1703041791\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__5ccae3ab-f964-4db6-932f-ccc4dcd9cd44\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small image_first text-left section-spacing\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\">\n<span class=\"animated-marker\">Smoother<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Model Surface</h2>\n<div class=\"rte\">\n<h4>Support advanced functions like input shaping and pressure advance to achieve smooth model surface and consistent extrusion</h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<div class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"564\" width=\"546\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-11-Smoother_Model_Surface_20x20_crop_center.jpg?v=1703041792\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shopify-section section-image-with-text\" id=\"shopify-section-template--15390705844272__cf46d79a-4564-4888-be93-58ccb5ce597c\">\n<div class=\"row\" id=\"\">\n<div class=\"small-12 columns\">\n<div class=\"image-with-text column-spacing--medium grid--image-small text_first text-left section-spacing\">\n<div class=\"image-with-text--content image-with-text--inner\">\n<div class=\"image-with-text--content--inner\">\n<h2 class=\"h3\">Intelligent<span> </span><span class=\"animated-marker\">Segmented<svg preserveaspectratio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewbox=\"0 0 201 14\" height=\"14\" width=\"201\" class=\"svg-marker svg-marker--style1\"><path stroke-linecap=\"round\" stroke-width=\"6\" stroke=\"var(--marker-color)\" d=\"M3 10.5732C55.565 6.61382 168.107 -0.117058 197.753 4.63415\"></path></svg></span><span> </span>Heatbed</h2>\n<div class=\"rte\">\n<h4><strong>With 100W+150W power output, the slicing software automatically recognizes the size of the model during slicing and activates the peripheral heating zone if the model size exceeds the center heating zone (120mmx120mm).</strong></h4>\n<h4><strong>The two partitions can also be turned on and off manually for more precise temperature control.</strong></h4>\n<h4><strong>Additionally, the surface of the PEI magnetic platform is marked for guidance.</strong></h4>\n</div>\n</div>\n</div>\n<div class=\"image-with-text--image image-with-text--inner\">\n<h4 class=\"image-with-text--image-media aspect-ratio aspect-ratio--adapt\"><img srcset=\"//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_630x650_crop_center.jpg?v=1703041792 630w\" sizes=\"498px\" alt=\"\" data-srcset=\"//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_690x711_crop_center.jpg?v=1703041792 690w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_1280x1320_crop_center.jpg?v=1703041792 1280w,//www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_630x650_crop_center.jpg?v=1703041792 630w\" src=\"https://www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_20x20_crop_center.jpg?v=1703041792\" data-sizes=\"auto\" height=\"558\" width=\"541\" class=\"lazyautosizes lazyloaded\" data-mce-src=\"https://www.elegoo.com/cdn/shop/files/N4P-12-Intelligent_Segmented_Heatbed_20x20_crop_center.jpg?v=1703041792\"></h4>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444024496-307098507.jpg"]},{"id":"fe003f6f-04b0-49f7-a4fb-ab546fb909f9","mrp":39999,"sku":"elegoo-neptune-4-max-3d-printer","name":"ELEGOO Neptune 4 Max","slug":"elegoo-neptune-4-max-3d-printer","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":2,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025476-394335114.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444025365-385107070.jpg","isPri