],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893426-210916814.png"},{"id":"4fa9d52c-7456-4f26-bc29-c3b4451116c4","sku":"anycubic-standard-v2-resin-1kg-beige","name":"beige","price":"1999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-19T06:55:36.361Z","deletedAt":null,"isDefault":false,"productId":"5a82d15a-d4c0-4ffb-90f1-60b4c454a97f","salePrice":null,"updatedAt":"2026-07-19T06:55:36.361Z","variantSlug":null,"optionValues":{"Color":"beige"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png"},{"id":"09f92a3a-0df6-4036-a35e-ca8ff8569b98","sku":"anycubic-standard-v2-resin-1kg-black","name":"black","price":"1999","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"0","isActive":true,"createdAt":"2026-07-19T06:55:36.913Z","deletedAt":null,"isDefault":false,"productId":"5a82d15a-d4c0-4ffb-90f1-60b4c454a97f","salePrice":null,"updatedAt":"2026-07-19T06:55:36.913Z","variantSlug":null,"optionValues":{"Color":"black"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png"}],"salePrice":1999,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893415-465229351.png","isFeatured":false,"category_id":"55a711ea-3f62-443b-9b00-dc8d361e5cac","dealerPrice":1999,"description":"<div class=\"accordion-title\" data-bs-target=\"#description\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"description\" role=\"button\">\n<span>Descriptions</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"description\" class=\"collapse show\">\n<div class=\"accordion-body widget-material\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>The Standard V2 resin is compatible with a wide range of LCD and DLP 3D printers, including models from Anycubic and other brands that support similar resin-based printing technologies.</li>\n<li>It typically comes in various colors such as clear, white, black, gray, and sometimes other colors like blue or green, providing options for different aesthetic preferences and applications.<br><br>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Strength &amp; High Toughness】Based on the classic ANYCUBIC 3D Printing Standard Resin, the ANYCUBIC Standard Resin V2 further enhances toughness, boosting an increase of 93% in elongation at break. The finished models are resistant to impact, and less prone to breaking, while still maintaining a certain degree of flexibility.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【 Lower-Odor】By upgrading the resin formula, the odor of ANYCUBIC Standard 3D Resin V2 has been significantly reduced, creating a more comfortable printing environment for users.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Wide-range of Applications】 As an entry-level resin, ANYCUBIC Standard 3D Print Resin V2 is suitable for printing high intensity models that require high strength and toughness, such as industrial parts, assemblies, tools, architectural models, prototype proofing, figure design, etc., while maintaining a high success printing rate.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Precision with Minimal Shrinkage】With an even lower shrinkage rate, the chance of distortion is decreased. Achieve top-notch precision and display sharp, vivid details in your prints.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Compatibility】Compatible with 365-405nm wide band, ANYCUBIC resin 3d printer liquid is suitable for most LCD and DLP light-curing 3D printers on the market, and easier to clean, helping novice users get started quickly.</li>\n</ul>\n</div>\n</div>\n</div>\n<br>\n</li>\n</ul>\n</div>\n</div>\n</div>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893415-465229351.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893415-465229351.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893680-445233726.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893426-210916814.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895549-246063097.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895698-357821516.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443896457-825345080.png"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893415-465229351.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893680-445233726.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893426-210916814.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893680-445233726.png","shortDescription":"<div class=\"accordion-title\" data-bs-target=\"#description\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"description\" role=\"button\">\n<span>Descriptions</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"description\" class=\"collapse show\">\n<div class=\"accordion-body widget-material\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>The Standard V2 resin is compatible with a wide range of LCD and DLP 3D printers, including models from Anycubic and other brands that support similar resin-based printing technologies.</li>\n<li>It typically comes in various colors such as clear, white, black, gray, and sometimes other colors like blue or green, providing options for different aesthetic preferences and applications.<br><br>\n<div class=\"accordion-title\" data-bs-target=\"#feature\" data-bs-toggle=\"collapse\" aria-expanded=\"true\" aria-controls=\"feature\" role=\"button\">\n<span>Features</span><span class=\"icon icon-arrow-down\"></span>\n</div>\n<div id=\"feature\" class=\"collapse show\">\n<div class=\"accordion-body widget-desc\">\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Strength &amp; High Toughness】Based on the classic ANYCUBIC 3D Printing Standard Resin, the ANYCUBIC Standard Resin V2 further enhances toughness, boosting an increase of 93% in elongation at break. The finished models are resistant to impact, and less prone to breaking, while still maintaining a certain degree of flexibility.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【 Lower-Odor】By upgrading the resin formula, the odor of ANYCUBIC Standard 3D Resin V2 has been significantly reduced, creating a more comfortable printing environment for users.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【Wide-range of Applications】 As an entry-level resin, ANYCUBIC Standard 3D Print Resin V2 is suitable for printing high intensity models that require high strength and toughness, such as industrial parts, assemblies, tools, architectural models, prototype proofing, figure design, etc., while maintaining a high success printing rate.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Precision with Minimal Shrinkage】With an even lower shrinkage rate, the chance of distortion is decreased. Achieve top-notch precision and display sharp, vivid details in your prints.</li>\n</ul>\n</div>\n<div class=\"item\">\n<ul class=\"item\">\n<li>【High Compatibility】Compatible with 365-405nm wide band, ANYCUBIC resin 3d printer liquid is suitable for most LCD and DLP light-curing 3D printers on the market, and easier to clean, helping novice users get started quickly.</li>\n</ul>\n</div>\n</div>\n</div>\n<br>\n</li>\n</ul>\n</div>\n</div>\n</div>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893415-465229351.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893680-445233726.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893426-210916814.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443893384-233166777.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443895969-643567652.png"]},{"id":"c2799f1e-0e30-42cc-8279-d4badb4ffaca","mrp":61500,"sku":"elegoo-saturn-4-ultra-16k-3d-printer","name":"ELEGOO Saturn 4 Ultra 16k 3D Printer","slug":"elegoo-saturn-4-ultra-16k-3d-printer","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443896336-77801338.webp","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443896345-589884147.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443896334-358555394.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"7580f0cf-3957-47d5-b6d3-11b775347411","sku":"elegoo-saturn-4-ultra-16k-3d-printer-Default Title","name":"Default Title","price":"61500","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443896336-77801338.webp","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"20000","isActive":true,"createdAt":"2026-07-19T06:55:38.827Z","deletedAt":null,"isDefault":false,"productId":"c2799f1e-0e30-42cc-8279-d4badb4ffaca","salePrice":null,"updatedAt":"2026-07-19T06:55:38.827Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443