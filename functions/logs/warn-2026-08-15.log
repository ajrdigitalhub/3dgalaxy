":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg"},{"id":"5611b488-ebcd-4b65-9336-6228c51f2d8d","sku":"3DPP004","name":"Purple","price":"499","stock":0,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"250","isActive":true,"createdAt":"2026-07-19T07:01:21.099Z","deletedAt":null,"isDefault":false,"productId":"f70301be-9c2a-4330-b6b7-0d966d93299e","salePrice":null,"updatedAt":"2026-07-19T07:01:21.099Z","variantSlug":null,"optionValues":{"Color":"Purple"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg"}],"salePrice":499,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052264-882586667.jpg","isFeatured":false,"category_id":"818c760a-e5d6-42fa-a68d-78bf45f3659d","dealerPrice":499,"description":"<span>Bring your imagination to life with our 3D Pen with LCD Display 2.0. This pen allows you to express your creativity with ease. The LCD display allows you to monitor and adjust the temperature with precision, making the 3D pen simple and effortless to use. Bring your ideas to life with this advanced 3D printing tool.</span>\n<ul class=\"a-unordered-list a-vertical a-spacing-mini\" data-mce-fragment=\"1\">\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">3D printing pen is made of eco-friendly ABS material and supplied by Premium PLA Filament Refills that are non-toxic, non-irritating and 100% derived from plants. It offers better scald prevention with 2019 upgraded features of Intelligent temperature control, fast heat dissipation technology. </span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">Simply plug-in, heat up and extrude to start your journal! Great for both beginners and experienced 3D printing enthusiasts! The filament is heated through the pen body and cooled much down even before it comes out of the nozzle, safe for kids to use. Our newly designed pen also has Auto Sleep Function.</span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">The aircraft-grade ceramic nozzle can endure high temperatures and its interior surface is so smooth that the PLA filament in the high temperature state is impossible to attach, thus effectively reducing the risk of clogging. And thanks to the high quality motor with stable rotation speed and strong power, the output of the filament is stable and smooth.</span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">Different from other 3D pens on the market, Dikale 3D pen don’t need long press button, but press button once to make the creation easily and relax children’s finger. 3 printing temperature and speed modes adjustable. Advanced LCD screen clearly display the corresponding speed.</span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">The 3D drawing pen is compatible with both 1.75mm PLA and ABS filaments. 3 adjustable speeds corresponding to 3 different operating temperatures are intuitively displayed on the LCD screen. </span></li>\n</ul>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052264-882586667.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052264-882586667.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051647-930049608.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051917-683878123.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052606-655420813.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052264-882586667.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051917-683878123.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg"],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051647-930049608.jpg","shortDescription":"<span>Bring your imagination to life with our 3D Pen with LCD Display 2.0. This pen allows you to express your creativity with ease. The LCD display allows you to monitor and adjust the temperature with precision, making the 3D pen simple and effortless to use. Bring your ideas to life with this advanced 3D printing tool.</span>\n<ul class=\"a-unordered-list a-vertical a-spacing-mini\" data-mce-fragment=\"1\">\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">3D printing pen is made of eco-friendly ABS material and supplied by Premium PLA Filament Refills that are non-toxic, non-irritating and 100% derived from plants. It offers better scald prevention with 2019 upgraded features of Intelligent temperature control, fast heat dissipation technology. </span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">Simply plug-in, heat up and extrude to start your journal! Great for both beginners and experienced 3D printing enthusiasts! The filament is heated through the pen body and cooled much down even before it comes out of the nozzle, safe for kids to use. Our newly designed pen also has Auto Sleep Function.</span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">The aircraft-grade ceramic nozzle can endure high temperatures and its interior surface is so smooth that the PLA filament in the high temperature state is impossible to attach, thus effectively reducing the risk of clogging. And thanks to the high quality motor with stable rotation speed and strong power, the output of the filament is stable and smooth.</span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">Different from other 3D pens on the market, Dikale 3D pen don’t need long press button, but press button once to make the creation easily and relax children’s finger. 3 printing temperature and speed modes adjustable. Advanced LCD screen clearly display the corresponding speed.</span></li>\n<li data-mce-fragment=\"1\"><span class=\"a-list-item\" data-mce-fragment=\"1\">The 3D drawing pen is compatible with both 1.75mm PLA and ABS filaments. 3 adjustable speeds corresponding to 3 different operating temperatures are intuitively displayed on the LCD screen. </span></li>\n</ul>","variantSecondaryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052264-882586667.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051647-930049608.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444051648-248840061.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444052552-623393416.jpg"]},{"id":"8463c8fa-7b4b-4a93-a700-2e5ea9b575b2","mrp":25,"sku":"0-4-mm-needle-for-3d-printer-nozzle-cleaning","name":"0.4 mm Needle for 3D Printer Nozzle Cleaning","slug":"0-4-mm-needle-for-3d-printer-nozzle-cleaning","brand":"ac20995a-cd2b-4183-a53c-4f4ef658a9e5","stock":151,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444053352-965582070.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444053370-317383924.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444053349-908281883.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"rating":4.5,"variants":[{"id":"0756b4f7-209b-45b0-9f4e-ed196b2562e7","sku":"0-4-mm-needle-for-3d-printer-nozzle-cleaning-Default Title","name":"Default Title","price":"25","stock":151,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444053352-965582070.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"100","isActive":true,"createdAt":"2026-07-19T07:01:26.778Z","deletedAt":null,"isDefault":false,"productId":"8463c8fa-7b4b-4a93-a700-2e5ea9b575b2","salePrice":null,"updatedAt":"2026-07-19T07:01:2