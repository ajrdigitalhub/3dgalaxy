dAt":null,"isDefault":false,"productId":"aa6a297e-9f8a-427f-b0b5-7e661065b7db","salePrice":null,"updatedAt":"2026-07-19T06:56:49.263Z","variantSlug":null,"optionValues":{"Title":"Default Title"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg"}],"salePrice":1399,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg","isFeatured":false,"category_id":"38e835e1-457d-462b-a466-c1f4a2ee3a04","dealerPrice":1399,"description":"<h3 data-start=\"104\" data-end=\"173\"><strong data-start=\"108\" data-end=\"173\">Cool Build Plate – Low Temperature, Double-Sided Textured PEI</strong></h3>\n<p data-start=\"175\" data-end=\"499\">Upgrade your 3D printing setup with this versatile <strong data-start=\"226\" data-end=\"284\">low-temperature, double-sided textured PEI build plate</strong>, designed for consistent adhesion, smooth printing performance, and easy part removal. Its specialized PEI surface offers strong grip during printing while still allowing prints to pop off effortlessly once cooled.</p>\n<h4 data-start=\"501\" data-end=\"522\"><strong data-start=\"506\" data-end=\"522\">Key Features</strong></h4>\n<ul data-start=\"523\" data-end=\"1428\">\n<li data-start=\"523\" data-end=\"702\">\n<p data-start=\"525\" data-end=\"702\"><strong data-start=\"525\" data-end=\"558\">Double-Sided Textured Surface</strong><br data-start=\"558\" data-end=\"561\">Both sides feature a durable textured PEI coating, providing excellent adhesion for a wide range of materials without additional adhesives.</p>\n</li>\n<li data-start=\"704\" data-end=\"871\">\n<p data-start=\"706\" data-end=\"871\"><strong data-start=\"706\" data-end=\"739\">Low-Temperature Compatibility</strong><br data-start=\"739\" data-end=\"742\">Engineered for efficient performance at lower bed temperatures, ideal for materials like PLA, PETG, TPU, and similar filaments.</p>\n</li>\n<li data-start=\"873\" data-end=\"1010\">\n<p data-start=\"875\" data-end=\"1010\"><strong data-start=\"875\" data-end=\"902\">Cold Release Technology</strong><br data-start=\"902\" data-end=\"905\">Parts detach naturally after cooling, reducing the risk of damage and making print removal hassle-free.</p>\n</li>\n<li data-start=\"1012\" data-end=\"1161\">\n<p data-start=\"1014\" data-end=\"1161\"><strong data-start=\"1014\" data-end=\"1043\">Warp-Resistant Metal Base</strong><br data-start=\"1043\" data-end=\"1046\">The rigid metal sheet ensures uniform heat distribution and maintains flatness throughout long printing sessions.</p>\n</li>\n<li data-start=\"1163\" data-end=\"1296\">\n<p data-start=\"1165\" data-end=\"1296\"><strong data-start=\"1165\" data-end=\"1185\">Easy Maintenance</strong><br data-start=\"1185\" data-end=\"1188\">Simply wipe with isopropyl alcohol to restore adhesion; resistant to scratches and wear from repeated use.</p>\n</li>\n<li data-start=\"1298\" data-end=\"1428\">\n<p data-start=\"1300\" data-end=\"1428\"><strong data-start=\"1300\" data-end=\"1321\">Quick Swap Design</strong><br data-start=\"1321\" data-end=\"1324\">Flexible plate structure allows for fast installation and removal, minimizing downtime between prints.</p>\n</li>\n</ul>\n<h4 data-start=\"1430\" data-end=\"1459\"><strong data-start=\"1435\" data-end=\"1459\">Compatible Materials</strong></h4>\n<ul data-start=\"1460\" data-end=\"1543\">\n<li data-start=\"1460\" data-end=\"1467\">\n<p data-start=\"1462\" data-end=\"1467\">PLA</p>\n</li>\n<li data-start=\"1468\" data-end=\"1476\">\n<p data-start=\"1470\" data-end=\"1476\">PETG</p>\n</li>\n<li data-start=\"1477\" data-end=\"1484\">\n<p data-start=\"1479\" data-end=\"1484\">TPU</p>\n</li>\n<li data-start=\"1485\" data-end=\"1509\">\n<p data-start=\"1487\" data-end=\"1509\">PLA-based composites</p>\n</li>\n<li data-start=\"1510\" data-end=\"1543\">\n<p data-start=\"1512\" data-end=\"1543\">Other low-temperature filaments</p>\n</li>\n</ul>\n<h4 data-start=\"1545\" data-end=\"1563\"><strong data-start=\"1550\" data-end=\"1563\">Ideal For</strong></h4>\n<ul data-start=\"1564\" data-end=\"1692\">\n<li data-start=\"1564\" data-end=\"1585\">\n<p data-start=\"1566\" data-end=\"1585\">Everyday printing</p>\n</li>\n<li data-start=\"1586\" data-end=\"1601\">\n<p data-start=\"1588\" data-end=\"1601\">Prototyping</p>\n</li>\n<li data-start=\"1602\" data-end=\"1628\">\n<p data-start=\"1604\" data-end=\"1628\">High-volume production</p>\n</li>\n<li data-start=\"1629\" data-end=\"1692\">\n<p data-start=\"1631\" data-end=\"1692\">Users who want reliable adhesion with effortless part removal</p>\n</li>\n</ul>","isExclusive":false,"reviewCount":12,"codAvailable":true,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919772-342056865.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919771-999352067.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919605-358019130.jpg","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443921303-522446443.jpg"],"variantImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443919598-99671148.jpg"],"secondaryImage":"https://storage