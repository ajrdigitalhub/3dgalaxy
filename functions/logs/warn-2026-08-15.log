eryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444034524-579135902.jpg"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444034524-579135902.jpg","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444034524-579135902.jpg"},{"id":"75ddec84-c522-4948-87e7-a244d1e1185f","sku":"petg-filament-1kg / Orange","name":"1kg / Orange","price":"800","stock":1,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444041971-222960796.png","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444037584-630873260.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1000","isActive":true,"createdAt":"2026-08-08T20:42:55.664Z","deletedAt":null,"isDefault":false,"productId":"d586c6ac-b500-47c1-9847-c10f0273f6c0","salePrice":null,"updatedAt":"2026-08-08T20:42:55.664Z","variantSlug":null,"optionValues":{"Size":"1kg","Color":"Orange"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444041971-222960796.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444041971-222960796.png","https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444037584-630873260.png"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444041971-222960796.png","isPrimary":false,"sortOrder":0,"isSecondary":false},{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444037584-630873260.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444037584-630873260.png"}],"avgRating":0,"salePrice":800,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444030105-547182972.png","categories":[],"categoryId":null,"isFeatured":false,"weightUnit":"g","categoryIds":[],"category_id":"17eab5d8-a0b0-45bb-9b7f-7319e05d671c","dealerPrice":800,"description":"<hr data-start=\"110\" data-end=\"113\">\n<h3 data-start=\"115\" data-end=\"168\"><strong data-start=\"119\" data-end=\"168\">PETG 1.75mm 3D Printer Filament – Description</strong></h3>\n<p data-start=\"170\" data-end=\"466\"><strong data-start=\"170\" data-end=\"178\">PETG</strong> (Polyethylene Terephthalate Glycol-modified) is a premium thermoplastic filament known for combining the best characteristics of PLA and ABS. It offers exceptional strength, flexibility, and chemical resistance, making it ideal for functional parts, prototypes, and outdoor applications.</p>\n<hr data-start=\"468\" data-end=\"471\">\n<h3 data-start=\"473\" data-end=\"494\"><strong data-start=\"477\" data-end=\"494\">Key Features:</strong></h3>\n<ul data-start=\"496\" data-end=\"1334\">\n<li data-start=\"496\" data-end=\"652\">\n<p data-start=\"498\" data-end=\"652\">✅ <strong data-start=\"500\" data-end=\"531\">High Strength &amp; Durability:</strong><br data-start=\"531\" data-end=\"534\">PETG is tougher than PLA and more flexible than ABS, offering excellent impact resistance and long-term performance.</p>\n</li>\n<li data-start=\"654\" data-end=\"788\">\n<p data-start=\"656\" data-end=\"788\">✅ <strong data-start=\"658\" data-end=\"676\">Easy to Print:</strong><br data-start=\"676\" data-end=\"679\">Offers minimal warping and shrinkage, making it beginner-friendly while still meeting professional demands.</p>\n</li>\n<li data-start=\"790\" data-end=\"947\">\n<p data-start=\"792\" data-end=\"947\">✅ <strong data-start=\"794\" data-end=\"831\">Temperature &amp; Moisture Resistant:</strong><br data-start=\"831\" data-end=\"834\">Performs well under mechanical stress and is highly resistant to water and chemicals, suitable for outdoor use.</p>\n</li>\n<li data-start=\"949\" data-end=\"1061\">\n<p data-start=\"951\" data-end=\"1061\">✅ <strong data-start=\"953\" data-end=\"977\">Good Layer Adhesion:</strong><br data-start=\"977\" data-end=\"980\">Produces strong, seamless prints with minimal risk of delamination or cracking.</p>\n</li>\n<li data-start=\"1063\" data-end=\"1218\">\n<p data-start=\"1065\" data-end=\"1218\">✅ <strong data-start=\"1067\" data-end=\"1130\">Glossy, Transparent Finish (for natural or clear variants):</strong><br data-start=\"1130\" data-end=\"1133\">Yields aesthetically pleasing models with a slight shine and smooth surface finish.</p>\n</li>\n<li data-start=\"1220\" data-end=\"1334\">\n<p data-start=\"1222\" data-end=\"1334\">✅ <strong data-start=\"1224\" data-end=\"1246\">Odorless Printing:</strong><br data-start=\"1246\" data-end=\"1249\">Emits little to no odor during printing, providing a more pleasant user experience.</p>\n</li>\n</ul>\n<hr data-start=\"1336\" data-end=\"1339\">\n<h3 data-start=\"1341\" data-end=\"1364\"><strong data-start=\"1345\" data-end=\"1364\">Specifications:</strong></h3>\n<ul data-start=\"1366\" data-end=\"1742\">\n<li data-start=\"1366\" data-end=\"1422\">\n<p data-start=\"1368\" data-end=\"1422\"><strong data-start=\"1368\" data-end=\"1381\">Material:</strong> PETG (Polyethylene Terephthalate Glycol)</p>\n</li>\n<li data-start=\"1423\" data-end=\"1476\">\n<p data-start=\"1425\" data-end=\"1476\"><strong data-start=\"1425\" data-end=\"1438\">Diameter:</strong> 1.75mm (± 0.02mm precision tolerance)</p>\n</li>\n<li data-start=\"1477\" data-end=\"1515\">\n<p data-start=\"1479\" data-end=\"1515\"><strong data-start=\"1479\" data-end=\"1501\">Print Temperature:</strong> 230°C – 250°C</p>\n</li>\n<li data-start=\"1516\" data-end=\"1550\">\n<p data-start=\"1518\" data-end=\"1550\"><strong data-start=\"1518\" data-end=\"1538\">Bed Temperature:</strong> 70°C – 90°C</p>\n</li>\n<li data-start=\"1551\" data-end=\"1594\">\n<p data-start=\"1553\" data-end=\"1594\"><strong data-start=\"1553\" data-end=\"1569\">Print Speed:</strong> 40 – 60 mm/s recommended</p>\n</li>\n<li data-start=\"1595\" data-end=\"1667\">\n<p data-start=\"1597\" data-end=\"1667\"><strong data-start=\"1597\" data-end=\"1627\">Recommended Build Surface:</strong> PEI, glass bed with glue stick, or tape</p>\n</li>\n<li data-start=\"1668\" data-end=\"1694\">\n<p data-start=\"1670\" data-end=\"1694\"><strong data-start=\"1670\" data-end=\"1682\">Density:</strong> ~1.27 g/cm³</p>\n</li>\n<li data-start=\"1695\" data-end=\"1742\">\n<p data-start=\"1697\" data-end=\"1742\"><strong data-start=\"1697\" data-end=\"1708\">Weight:</strong> Typically available in 1kg spools</p>\n</li>\n</ul>\n<hr data-start=\"1744\" data-end=\"1747\">\n<h3 data-start=\"1749\" data-end=\"1770\"><strong data-start=\"1753\" data-end=\"1770\">Applications:</strong></h3>\n<ul data-start=\"1772\" data-end=\"1916\">\n<li data-start=\"1772\" data-end=\"1802\">\n<p data-start=\"1774\" data-end=\"1802\">Prototyping mechanical parts</p>\n</li>\n<li data-start=\"1803\" data-end=\"1824\">\n<p data-start=\"1805\" data-end=\"1824\">Electrical housings</p>\n</li>\n<li data-start=\"1825\" data-end=\"1844\">\n<p data-start=\"1827\" data-end=\"1844\">Medical equipment</p>\n</li>\n<li data-start=\"1845\" data-end=\"1875\">\n<p data-start=\"1847\" data-end=\"1875\">Outdoor tools and containers</p>\n</li>\n<li data-start=\"1876\" data-end=\"1916\">\n<p data-start=\"1878\" data-end=\"1916\">Transparent or semi-transparent prints</p>\n</li>\n</ul>","hasVariants":true,"isExclusive":false,"ratingCount":0,"reviewCount":0,"codAvailable":true,"latestReview":null,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784444030105-547182972.png","totalReviews":0,"averageRating":0,"galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/178444