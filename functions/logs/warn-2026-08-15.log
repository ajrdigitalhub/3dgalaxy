dgalaxy.firebasestorage.app/product-import/1784443948703-968795638.png"},{"id":"2650d980-f815-4acd-93d6-b086c34555ea","sku":"3d-galaxy-water-washable-resin-Crystal Orange to Purple","name":"Crystal Orange to Purple","price":"1900","stock":5,"images":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443943755-987663242.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"weight":"1000","isActive":true,"createdAt":"2026-07-19T06:57:16.652Z","deletedAt":null,"isDefault":false,"productId":"4154f59c-55bc-4714-a3e8-92f23fb2772b","salePrice":null,"updatedAt":"2026-07-19T06:57:16.652Z","variantSlug":null,"optionValues":{"Colour":"Crystal Orange to Purple"},"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443943755-987663242.png","galleryImages":["https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443943755-987663242.png"],"variantImages":[{"url":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443943755-987663242.png","isPrimary":false,"sortOrder":0,"isSecondary":false}],"secondaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443943755-987663242.png"}],"avgRating":0,"salePrice":1900,"thumbnail":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443953017-152593927.png","categories":[],"categoryId":null,"isFeatured":false,"weightUnit":"g","categoryIds":[],"category_id":"55a711ea-3f62-443b-9b00-dc8d361e5cac","dealerPrice":1900,"description":"<p data-end=\"178\" data-start=\"80\"><strong data-end=\"97\" data-start=\"80\">Product Name:</strong><br data-end=\"100\" data-start=\"97\">3D Galaxy UV Sensitive Water Washable Resin </p>\n<p data-end=\"595\" data-start=\"180\"><strong data-end=\"196\" data-start=\"180\">Description:</strong><br data-end=\"199\" data-start=\"196\">3D Galaxy UV Sensitive Resin is designed for high-quality 3D printing, offering precision, strength, and smooth surface finishing. This <strong data-end=\"361\" data-start=\"335\">water washable formula</strong> makes post-processing easy, eliminating the need for harsh chemicals or alcohol cleaning. Its <strong data-end=\"506\" data-start=\"456\">color-shifting Crystal Orange to Purple effect</strong> gives prints a unique aesthetic appeal while maintaining durability and functionality.</p>\n<p data-end=\"616\" data-start=\"597\"><strong data-end=\"614\" data-start=\"597\">Key Features:</strong></p>\n<p data-end=\"658\" data-start=\"619\"><strong data-end=\"632\" data-start=\"619\">Material:</strong> Water Washable UV Resin</p>\n<p data-end=\"717\" data-start=\"661\"><strong data-end=\"671\" data-start=\"661\">Color:</strong> Crystal Orange to Purple (chameleon effect)<br>           Crystal Purple to Blue <br>           Crystal Purple to Pink</p>\n<p data-end=\"743\" data-start=\"720\"><strong data-end=\"731\" data-start=\"720\">Weight:</strong> 1kg (net)</p>\n<p data-end=\"788\" data-start=\"746\"><strong data-end=\"757\" data-start=\"746\">Finish:</strong> Smooth, detailed, and strong</p>\n<p data-end=\"823\" data-start=\"791\"><strong data-end=\"800\" data-start=\"791\">Odor:</strong> Low-odor formulation</p>\n<p data-end=\"892\" data-start=\"826\"><strong data-end=\"842\" data-start=\"826\">Ease of Use:</strong> No need for IPA; simply rinse prints with water</p>\n<p data-end=\"973\" data-start=\"895\"><strong data-end=\"908\" data-start=\"895\">Hardness:</strong> Comparable to ABS-like resin, providing strength and toughness</p>\n<p data-end=\"1064\" data-start=\"976\"><strong data-end=\"993\" data-start=\"976\">Applications:</strong> Miniatures, functional parts, jewelry, decorative models, prototypes</p>\n<p data-end=\"1092\" data-start=\"1066\"><strong data-end=\"1090\" data-start=\"1066\">Printing Parameters:</strong></p>\n<p data-end=\"1128\" data-start=\"1095\"><strong data-end=\"1126\" data-start=\"1095\">Mono Screen (LCD Printers):</strong></p>\n<p data-end=\"1158\" data-start=\"1133\">Bottom Exposure: 15–25s</p>\n<p data-end=\"1185\" data-start=\"1163\">Layer Exposure: 2–3s</p>\n<p data-end=\"1226\" data-start=\"1188\"><strong data-end=\"1224\" data-start=\"1188\">RGB Screen (Older LCD Printers):</strong></p>\n<p data-end=\"1256\" data-start=\"1231\">Bottom Exposure: 50–60s</p>\n<p data-end=\"1283\" data-start=\"1261\">Layer Exposure: 6–8s</p>\n<p data-end=\"1365\" data-start=\"1285\"><strong data-end=\"1300\" data-start=\"1285\">Shelf Life:</strong> 2 years (store in a cool, dry place away from direct sunlight)</p>\n<p data-end=\"1392\" data-start=\"1367\"><strong data-end=\"1390\" data-start=\"1367\">Safety Precautions:</strong></p>\n<p data-end=\"1419\" data-start=\"1395\">Shake well before use.</p>\n<p data-end=\"1463\" data-start=\"1422\">Wear gloves and a mask during handling.</p>\n<p data-end=\"1532\" data-start=\"1466\">Avoid direct skin contact; wash with plenty of water if exposed.</p>\n<p data-end=\"1551\" data-start=\"1535\">Do not ingest.</p>\n<p data-end=\"1586\" data-start=\"1554\">Keep out of reach of children.</p>\n<p data-end=\"1621\" data-start=\"1589\">Use in a well-ventilated area.</p>\n<p data-end=\"1840\" data-start=\"1623\"><strong data-end=\"1638\" data-start=\"1623\">Advantages:</strong><br data-end=\"1641\" data-start=\"1638\">✅ Easy water cleanup – no alcohol needed<br data-end=\"1684\" data-start=\"1681\">✅ High precision &amp; detail reproduction<br data-end=\"1725\" data-start=\"1722\">✅ Strong &amp; durable prints<br data-end=\"1753\" data-start=\"1750\">✅ Unique dual-color shifting resin<br data-end=\"1790\" data-start=\"1787\">✅ Ideal for hobbyists, makers, and professionals</p>","hasVariants":true,"isExclusive":false,"ratingCount":0,"reviewCount":0,"codAvailable":true,"latestReview":null,"primaryImage":"https://storage.googleapis.com/ajr3dgalaxy.firebasestorage.app/product-import/1784443953017-152593927.png","totalReviews":0,"averageRating":0,"galle