 mm (Optional: 0.2 / 0.6 / 0.8 mm)</td>\n<td data-end=\"1464\" data-start=\"1419\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">0.4 mm</td>\n<td data-end=\"1511\" data-start=\"1464\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">0.4 mm (Optional: 0.2 / 0.6 / 0.8 mm)</td>\n</tr>\n<tr data-end=\"1686\" data-start=\"1512\">\n<td data-end=\"1545\" data-start=\"1512\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\"><strong data-end=\"1537\" data-start=\"1514\">Multicolor Printing</strong></td>\n<td data-end=\"1594\" data-start=\"1545\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Supported (Up to 8 colors with ACE Pro)</td>\n<td data-end=\"1639\" data-start=\"1594\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Not supported</td>\n<td data-end=\"1686\" data-start=\"1639\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Supported (Up to 4 colors)</td>\n</tr>\n<tr data-end=\"1861\" data-start=\"1687\">\n<td data-end=\"1720\" data-start=\"1687\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\"><strong data-end=\"1705\" data-start=\"1689\">X-Axis Motor</strong></td>\n<td data-end=\"1769\" data-start=\"1720\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Single motor</td>\n<td data-end=\"1814\" data-start=\"1769\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Single motor</td>\n<td data-end=\"1861\" data-start=\"1814\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Single motor</td>\n</tr>\n<tr data-end=\"2036\" data-start=\"1862\">\n<td data-end=\"1895\" data-start=\"1862\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\"><strong data-end=\"1881\" data-start=\"1864\">Y-Axis Motors</strong></td>\n<td data-end=\"1944\" data-start=\"1895\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Dual motors</td>\n<td data-end=\"1989\" data-start=\"1944\" class=\"max-w-[calc(var(--thread-content-max-width)*2/3)]\">Single motor</td>\n